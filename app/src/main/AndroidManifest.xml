<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Firebase (sign-in and the database) needs the internet. -->
    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:name=".LeefApplication"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:enableOnBackInvokedCallback="true"
        android:supportsRtl="true"
        android:theme="@style/Theme.LEEF"
        tools:targetApi="33">
        <!-- Screen 1: Welcome / Onboarding (app entry point). -->
        <activity
            android:name=".onboarding.OnboardingActivity"
            android:exported="true"
            android:theme="@style/Theme.LEEF.Onboarding">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Screen 2: Create Account. -->
        <activity
            android:name=".auth.CreateAccountActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <!-- Screen 3: Log In. -->
        <activity
            android:name=".auth.LogInActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <!-- Verify Email: asks new (or unverified) accounts to tap the link in the Firebase email. -->
        <activity
            android:name=".auth.VerifyEmailActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <!-- First Google sign-in: asks for the school/organization and role that Google doesn't provide. -->
        <activity
            android:name=".auth.CompleteProfileActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <!-- Main app shell; becomes the Home / Event Feed host in Screen 4. -->
        <activity
            android:name=".MainActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <!-- Screen 5: Search & Filter Events. -->
        <activity
            android:name=".search.SearchActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <!-- Screen 6: Event Details. -->
        <activity
            android:name=".details.EventDetailsActivity"
            android:exported="false" />

        <!-- Screen 7: Registration & Payment (simulated payment). -->
        <activity
            android:name=".registration.RegistrationActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

    </application>

</manifest>