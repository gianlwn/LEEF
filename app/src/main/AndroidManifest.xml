<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Firebase (sign-in and the database) needs the internet. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Lets the app notice when the phone goes offline, to show the "No internet connection" page. -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- Event reminders (Screen 9): the notification itself (Android 13+ asks first) and putting
         the reminders back after the phone restarts. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <application
        android:name=".LeefApplication"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:enableOnBackInvokedCallback="true"
        android:supportsRtl="true"
        android:theme="@style/Theme.LEEF"
        tools:targetApi="33">
        <!-- Screen 1: Welcome / Onboarding (app entry point). -->
        <activity
            android:name=".onboarding.OnboardingActivity"
            android:exported="true"
            android:theme="@style/Theme.LEEF.Onboarding">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Screen 2: Create Account. -->
        <activity
            android:name=".auth.CreateAccountActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <!-- Screen 3: Log In. -->
        <activity
            android:name=".auth.LogInActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <!-- Verify Email: asks new (or unverified) accounts to tap the link in the Firebase email. -->
        <activity
            android:name=".auth.VerifyEmailActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <!-- First Google sign-in: asks for the school/organization and role that Google doesn't provide. -->
        <activity
            android:name=".auth.CompleteProfileActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <!-- Main app shell; becomes the Home / Event Feed host in Screen 4. -->
        <activity
            android:name=".MainActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <!-- Screen 5: Search & Filter Events. -->
        <activity
            android:name=".search.SearchActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <!-- Screen 6: Event Details. -->
        <activity
            android:name=".details.EventDetailsActivity"
            android:exported="false" />

        <!-- Screen 7: Registration & Payment (simulated payment). -->
        <activity
            android:name=".registration.RegistrationActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <!-- Screen 10: one chat (an event's group chat or a direct chat). -->
        <activity
            android:name=".messages.ChatActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <!-- Screen 11: Create / Post Event (organizer accounts only). -->
        <activity
            android:name=".postevent.CreateEventActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <!-- Profile tab: change your name, school or organization and role. -->
        <activity
            android:name=".profile.EditProfileActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <!-- Promote Event: an organizer pays (simulated) to feature an event on Home and in Search. -->
        <activity
            android:name=".boost.BoostActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <!-- Terms of Service and Privacy Policy (opened from Create Account, Complete Profile and Profile). -->
        <activity
            android:name=".legal.LegalActivity"
            android:exported="false" />

        <!-- Screen 12: rate an event after it ends, and the organizer's list of that feedback. -->
        <activity
            android:name=".feedback.FeedbackActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name=".feedback.FeedbackListActivity"
            android:exported="false" />

        <!-- Screen 9: Check-in ticket with the QR code (opened from the reminder notification too). -->
        <activity
            android:name=".checkin.CheckInActivity"
            android:exported="false" />

        <!-- Screen 9: shows the "event starts in 1 hour" notification when its alarm goes off. -->
        <receiver
            android:name=".reminder.ReminderReceiver"
            android:exported="false" />

        <!-- Screen 9: alarms are forgotten when the phone restarts or the app updates, so set them again. -->
        <receiver
            android:name=".reminder.BootReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

    </application>

</manifest>