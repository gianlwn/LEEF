<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">

    <style name="ShapeAppearance.LEEF.Pill" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">50%</item>
    </style>

    <!-- Default filled button: pill shaped, brand green, bold label. -->
    <style name="Widget.LEEF.Button" parent="Widget.Material3.Button">
        <item name="android:minHeight">56dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:textAppearance">@style/TextAppearance.LEEF.Button</item>
        <item name="shapeAppearance">@style/ShapeAppearance.LEEF.Pill</item>
    </style>

    <!-- Large call-to-action with a soft green shadow (onboarding "Get Started"). -->
    <style name="Widget.LEEF.Button.Hero">
        <item name="android:minHeight">60dp</item>
        <item name="android:textAppearance">@style/TextAppearance.LEEF.Button.Large</item>
        <item name="android:stateListAnimator">@null</item>
        <item name="android:elevation">6dp</item>
        <item name="android:outlineAmbientShadowColor" tools:targetApi="28">@color/leef_green_700</item>
        <item name="android:outlineSpotShadowColor" tools:targetApi="28">@color/leef_green_700</item>
        <item name="iconGravity">textEnd</item>
        <item name="iconPadding">10dp</item>
        <item name="iconSize">20dp</item>
    </style>

    <style name="Widget.LEEF.Button.TextButton" parent="Widget.Material3.Button.TextButton">
        <item name="android:minHeight">48dp</item>
        <item name="android:textAppearance">@style/TextAppearance.LEEF.Button</item>
        <item name="android:textColor">@color/leef_green_800</item>
        <item name="rippleColor">@color/leef_green_100</item>
    </style>

    <!-- White outlined pill for "Continue with Google"; the Google logo keeps its own colours. -->
    <style name="Widget.LEEF.Button.Google" parent="Widget.Material3.Button.OutlinedButton">
        <item name="android:minHeight">56dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:textAppearance">@style/TextAppearance.LEEF.Button</item>
        <item name="android:textColor">@color/leef_ink</item>
        <item name="shapeAppearance">@style/ShapeAppearance.LEEF.Pill</item>
        <item name="backgroundTint">@color/white</item>
        <item name="strokeColor">@color/leef_gray_300</item>
        <item name="strokeWidth">1dp</item>
        <item name="rippleColor">@color/leef_green_100</item>
        <item name="iconTint">@null</item>
        <item name="iconGravity">textStart</item>
        <item name="iconPadding">12dp</item>
        <item name="iconSize">22dp</item>
    </style>

    <!-- Rounded white text field with a sand outline (Create Account, Log In). -->
    <style name="Widget.LEEF.TextInputLayout" parent="Widget.Material3.TextInputLayout.OutlinedBox">
        <item name="boxBackgroundColor">@color/white</item>
        <item name="boxStrokeColor">@color/leef_input_stroke</item>
        <item name="boxStrokeErrorColor">@color/leef_error</item>
        <item name="boxStrokeWidth">1dp</item>
        <item name="boxStrokeWidthFocused">2dp</item>
        <item name="boxCornerRadiusTopStart">16dp</item>
        <item name="boxCornerRadiusTopEnd">16dp</item>
        <item name="boxCornerRadiusBottomStart">16dp</item>
        <item name="boxCornerRadiusBottomEnd">16dp</item>
        <item name="hintTextColor">@color/leef_green_700</item>
        <item name="android:textColorHint">@color/leef_gray_600</item>
        <item name="startIconTint">@color/leef_gray_600</item>
        <item name="endIconTint">@color/leef_gray_600</item>
        <item name="helperTextTextColor">@color/leef_gray_600</item>
        <item name="errorTextColor">@color/leef_error</item>
        <item name="errorIconTint">@color/leef_error</item>
        <item name="errorTextAppearance">@style/TextAppearance.LEEF.Auth.FieldError</item>
        <item name="helperTextTextAppearance">@style/TextAppearance.LEEF.Auth.FieldHelper</item>
    </style>

    <!-- Same field, for a read-only list of options. -->
    <style name="Widget.LEEF.TextInputLayout.Dropdown" parent="Widget.Material3.TextInputLayout.OutlinedBox.ExposedDropdownMenu">
        <item name="boxBackgroundColor">@color/white</item>
        <item name="boxStrokeColor">@color/leef_input_stroke</item>
        <item name="boxStrokeErrorColor">@color/leef_error</item>
        <item name="boxStrokeWidth">1dp</item>
        <item name="boxStrokeWidthFocused">2dp</item>
        <item name="boxCornerRadiusTopStart">16dp</item>
        <item name="boxCornerRadiusTopEnd">16dp</item>
        <item name="boxCornerRadiusBottomStart">16dp</item>
        <item name="boxCornerRadiusBottomEnd">16dp</item>
        <item name="hintTextColor">@color/leef_green_700</item>
        <item name="android:textColorHint">@color/leef_gray_600</item>
        <item name="startIconTint">@color/leef_gray_600</item>
        <item name="endIconTint">@color/leef_gray_600</item>
        <item name="helperTextTextColor">@color/leef_gray_600</item>
        <item name="errorTextColor">@color/leef_error</item>
        <item name="errorIconTint">@color/leef_error</item>
        <item name="errorTextAppearance">@style/TextAppearance.LEEF.Auth.FieldError</item>
        <item name="helperTextTextAppearance">@style/TextAppearance.LEEF.Auth.FieldHelper</item>
    </style>

    <!-- White spinner shown inside a filled button while it works. -->
    <style name="Widget.LEEF.CircularProgressIndicator.OnButton" parent="Widget.Material3.CircularProgressIndicator.ExtraSmall">
        <item name="indicatorColor">@color/white</item>
    </style>
    <!-- Home / Event Feed -->
    <style name="TextAppearance.LEEF.Home.Greeting" parent="TextAppearance.LEEF.BodyLarge">
        <item name="android:textSize">17sp</item>
        <item name="android:textColor">@color/leef_gray_700</item>
    </style>

    <style name="TextAppearance.LEEF.Home.Name" parent="TextAppearance.LEEF.HeadlineSmall">
        <item name="android:textSize">26sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/leef_ink</item>
    </style>

    <style name="TextAppearance.LEEF.Home.SectionTitle" parent="TextAppearance.LEEF.TitleLarge">
        <item name="android:textSize">22sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/leef_green_900</item>
    </style>

    <style name="TextAppearance.LEEF.Home.SeeAll" parent="TextAppearance.LEEF.TitleSmall">
        <item name="android:textSize">16sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/leef_green_700</item>
    </style>

    <style name="TextAppearance.LEEF.Home.Hint" parent="TextAppearance.LEEF.BodyLarge">
        <item name="android:textSize">16sp</item>
        <item name="android:textColor">@color/leef_gray_600</item>
    </style>

    <style name="TextAppearance.LEEF.Home.ChipLabel" parent="TextAppearance.LEEF.LabelMedium">
        <item name="android:textSize">13sp</item>
        <item name="android:textFontWeight" tools:targetApi="28">600</item>
        <item name="android:textColor">@color/leef_chip_label</item>
    </style>

    <style name="TextAppearance.LEEF.Home.StateTitle" parent="TextAppearance.LEEF.TitleLarge">
        <item name="android:textSize">22sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/leef_green_900</item>
    </style>

    <style name="TextAppearance.LEEF.Home.StateBody" parent="TextAppearance.LEEF.BodyLarge">
        <item name="android:textSize">16sp</item>
        <item name="android:textColor">@color/leef_gray_600</item>
    </style>

    <!-- Event cards -->
    <style name="TextAppearance.LEEF.Event.Title" parent="TextAppearance.LEEF.TitleLarge">
        <item name="android:textSize">21sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/leef_ink</item>
    </style>

    <style name="TextAppearance.LEEF.Event.RowTitle" parent="TextAppearance.LEEF.TitleMedium">
        <item name="android:textSize">17sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/leef_ink</item>
    </style>

    <style name="TextAppearance.LEEF.Event.Meta" parent="TextAppearance.LEEF.BodyMedium">
        <item name="android:textSize">15sp</item>
        <item name="android:textColor">@color/leef_gray_700</item>
    </style>

    <style name="TextAppearance.LEEF.Event.Tag" parent="TextAppearance.LEEF.LabelMedium">
        <item name="android:textSize">13sp</item>
        <item name="android:textFontWeight" tools:targetApi="28">600</item>
        <item name="android:textColor">@color/leef_green_900</item>
    </style>

    <style name="TextAppearance.LEEF.Event.Badge" parent="TextAppearance.LEEF.LabelLarge">
        <item name="android:textSize">13sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">0.06</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:textColor">@color/white</item>
    </style>

    <style name="TextAppearance.LEEF.Event.Price" parent="TextAppearance.LEEF.LabelMedium">
        <item name="android:textSize">13sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <!-- Bottom navigation bar -->
    <style name="TextAppearance.LEEF.Nav" parent="TextAppearance.LEEF.LabelMedium">
        <item name="android:textSize">12sp</item>
    </style>

    <style name="TextAppearance.LEEF.Nav.Active">
        <item name="android:textStyle">bold</item>
    </style>

    <style name="Widget.LEEF.BottomNavigation" parent="Widget.Material3.BottomNavigationView">
        <item name="backgroundTint">@color/white</item>
        <item name="itemIconTint">@color/leef_nav_item</item>
        <item name="itemTextColor">@color/leef_nav_item</item>
        <item name="itemTextAppearanceActive">@style/TextAppearance.LEEF.Nav.Active</item>
        <item name="itemTextAppearanceInactive">@style/TextAppearance.LEEF.Nav</item>
        <item name="labelVisibilityMode">labeled</item>
        <item name="elevation">0dp</item>
    </style>

    <!-- Screen 5 - Search & Filter Events -->
    <!-- Option chips in the Filters sheet: white pill, solid green when picked. -->
    <style name="Widget.LEEF.FilterChip" parent="Widget.Material3.Chip.Filter">
        <item name="android:textAppearance">@style/TextAppearance.LEEF.Search.Chip</item>
        <item name="android:textColor">@color/leef_filter_chip_text</item>
        <item name="chipBackgroundColor">@color/leef_filter_chip_bg</item>
        <item name="chipStrokeColor">@color/leef_filter_chip_stroke</item>
        <item name="chipStrokeWidth">1dp</item>
        <item name="chipMinHeight">44dp</item>
        <item name="chipStartPadding">8dp</item>
        <item name="chipEndPadding">8dp</item>
        <item name="checkedIconVisible">false</item>
        <item name="chipIconVisible">false</item>
        <item name="rippleColor">@color/leef_green_100</item>
        <item name="shapeAppearanceOverlay">@style/ShapeAppearance.LEEF.Pill</item>
    </style>

    <!-- The Date / Location / Category shortcuts under the search box. -->
    <style name="Widget.LEEF.QuickChip" parent="Widget.Material3.Chip.Assist">
        <item name="android:textAppearance">@style/TextAppearance.LEEF.Search.Chip</item>
        <item name="android:textColor">@color/leef_ink</item>
        <item name="chipBackgroundColor">@color/white</item>
        <item name="chipStrokeColor">@color/leef_outline</item>
        <item name="chipStrokeWidth">1dp</item>
        <item name="chipMinHeight">44dp</item>
        <item name="chipStartPadding">8dp</item>
        <item name="chipEndPadding">8dp</item>
        <item name="rippleColor">@color/leef_green_100</item>
        <item name="shapeAppearanceOverlay">@style/ShapeAppearance.LEEF.Pill</item>
    </style>

    <style name="TextAppearance.LEEF.Search.Chip" parent="TextAppearance.Material3.LabelLarge">
        <item name="android:textSize">15sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="TextAppearance.LEEF.Search.FieldText" parent="TextAppearance.LEEF.BodyLarge">
        <item name="android:textColor">@color/leef_ink</item>
    </style>

    <!-- The Filters bottom sheet: cream, rounded top, and it pads itself for the navigation bar. -->
    <style name="Widget.LEEF.BottomSheet" parent="Widget.Material3.BottomSheet">
        <item name="backgroundTint">@color/leef_background</item>
        <item name="paddingBottomSystemWindowInsets">false</item>
        <item name="shapeAppearanceOverlay">@style/ShapeAppearance.LEEF.Sheet</item>
    </style>

    <style name="ShapeAppearance.LEEF.Sheet" parent="">
        <item name="cornerFamilyTopLeft">rounded</item>
        <item name="cornerFamilyTopRight">rounded</item>
        <item name="cornerFamilyBottomLeft">rounded</item>
        <item name="cornerFamilyBottomRight">rounded</item>
        <item name="cornerSizeTopLeft">28dp</item>
        <item name="cornerSizeTopRight">28dp</item>
        <item name="cornerSizeBottomLeft">0dp</item>
        <item name="cornerSizeBottomRight">0dp</item>
    </style>

    <style name="ThemeOverlay.LEEF.BottomSheetDialog" parent="ThemeOverlay.Material3.BottomSheetDialog">
        <item name="bottomSheetStyle">@style/Widget.LEEF.BottomSheet</item>
    </style>

    <!-- Screen 6 - Event Details -->
    <style name="TextAppearance.LEEF.Details.Title" parent="TextAppearance.LEEF.HeadlineSmall">
        <item name="android:textSize">26sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/leef_ink</item>
    </style>

    <style name="TextAppearance.LEEF.Details.Summary" parent="TextAppearance.LEEF.BodyLarge">
        <item name="android:textSize">17sp</item>
        <item name="android:lineSpacingMultiplier">1.15</item>
        <item name="android:textColor">@color/leef_gray_600</item>
    </style>

    <style name="TextAppearance.LEEF.Details.Line" parent="TextAppearance.LEEF.TitleMedium">
        <item name="android:textSize">18sp</item>
        <item name="android:textColor">@color/leef_ink</item>
    </style>

    <style name="TextAppearance.LEEF.Details.Label" parent="TextAppearance.LEEF.BodyMedium">
        <item name="android:textSize">15sp</item>
        <item name="android:textColor">@color/leef_gray_600</item>
    </style>

    <style name="TextAppearance.LEEF.Details.Organizer" parent="TextAppearance.LEEF.TitleMedium">
        <item name="android:textSize">19sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/leef_ink</item>
    </style>

    <style name="TextAppearance.LEEF.Details.PriceMain" parent="TextAppearance.LEEF.HeadlineMedium">
        <item name="android:textSize">36sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/leef_green_900</item>
    </style>

    <style name="TextAppearance.LEEF.Details.PriceSecond" parent="TextAppearance.LEEF.HeadlineMedium">
        <item name="android:textSize">30sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/leef_ink</item>
    </style>

    <style name="TextAppearance.LEEF.Details.PriceCaption" parent="TextAppearance.LEEF.BodyMedium">
        <item name="android:textSize">15sp</item>
        <item name="android:textColor">@color/leef_gray_600</item>
    </style>

    <!-- Small mint pill button (View Map). -->
    <style name="Widget.LEEF.Button.Tonal">
        <item name="android:minHeight">44dp</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:paddingStart">18dp</item>
        <item name="android:paddingEnd">18dp</item>
        <item name="android:textAppearance">@style/TextAppearance.LEEF.Details.ButtonTonal</item>
        <item name="backgroundTint">@color/leef_green_100</item>
        <item name="android:textColor">@color/leef_green_900</item>
        <item name="rippleColor">@color/leef_green_500</item>
        <item name="android:stateListAnimator">@null</item>
    </style>

    <style name="TextAppearance.LEEF.Details.ButtonTonal" parent="TextAppearance.LEEF.Button">
        <item name="android:textSize">15sp</item>
        <item name="android:textColor">@color/leef_green_900</item>
    </style>
</resources>
