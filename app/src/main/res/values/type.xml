<?xml version="1.0" encoding="utf-8"?>
<!-- LEEF type scale. Every Material 3 role is remapped to the brand font (@font/leef_sans). -->
<resources xmlns:tools="http://schemas.android.com/tools">

    <style name="TextAppearance.LEEF.DisplaySmall" parent="TextAppearance.Material3.DisplaySmall">
        <item name="android:fontFamily">@font/leef_sans</item>
        <item name="fontFamily">@font/leef_sans</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="TextAppearance.LEEF.HeadlineLarge" parent="TextAppearance.Material3.HeadlineLarge">
        <item name="android:fontFamily">@font/leef_sans</item>
        <item name="fontFamily">@font/leef_sans</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="TextAppearance.LEEF.HeadlineMedium" parent="TextAppearance.Material3.HeadlineMedium">
        <item name="android:fontFamily">@font/leef_sans</item>
        <item name="fontFamily">@font/leef_sans</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="TextAppearance.LEEF.HeadlineSmall" parent="TextAppearance.Material3.HeadlineSmall">
        <item name="android:fontFamily">@font/leef_sans</item>
        <item name="fontFamily">@font/leef_sans</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="TextAppearance.LEEF.TitleLarge" parent="TextAppearance.Material3.TitleLarge">
        <item name="android:fontFamily">@font/leef_sans</item>
        <item name="fontFamily">@font/leef_sans</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="TextAppearance.LEEF.TitleMedium" parent="TextAppearance.Material3.TitleMedium">
        <item name="android:fontFamily">@font/leef_sans</item>
        <item name="fontFamily">@font/leef_sans</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="TextAppearance.LEEF.TitleSmall" parent="TextAppearance.Material3.TitleSmall">
        <item name="android:fontFamily">@font/leef_sans</item>
        <item name="fontFamily">@font/leef_sans</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="TextAppearance.LEEF.BodyLarge" parent="TextAppearance.Material3.BodyLarge">
        <item name="android:fontFamily">@font/leef_sans</item>
        <item name="fontFamily">@font/leef_sans</item>
    </style>

    <style name="TextAppearance.LEEF.BodyMedium" parent="TextAppearance.Material3.BodyMedium">
        <item name="android:fontFamily">@font/leef_sans</item>
        <item name="fontFamily">@font/leef_sans</item>
    </style>

    <style name="TextAppearance.LEEF.BodySmall" parent="TextAppearance.Material3.BodySmall">
        <item name="android:fontFamily">@font/leef_sans</item>
        <item name="fontFamily">@font/leef_sans</item>
    </style>

    <style name="TextAppearance.LEEF.LabelLarge" parent="TextAppearance.Material3.LabelLarge">
        <item name="android:fontFamily">@font/leef_sans</item>
        <item name="fontFamily">@font/leef_sans</item>
        <item name="android:textFontWeight" tools:targetApi="28">500</item>
    </style>

    <style name="TextAppearance.LEEF.LabelMedium" parent="TextAppearance.Material3.LabelMedium">
        <item name="android:fontFamily">@font/leef_sans</item>
        <item name="fontFamily">@font/leef_sans</item>
        <item name="android:textFontWeight" tools:targetApi="28">500</item>
    </style>

    <style name="TextAppearance.LEEF.LabelSmall" parent="TextAppearance.Material3.LabelSmall">
        <item name="android:fontFamily">@font/leef_sans</item>
        <item name="fontFamily">@font/leef_sans</item>
        <item name="android:textFontWeight" tools:targetApi="28">500</item>
    </style>

    <!-- Buttons -->
    <style name="TextAppearance.LEEF.Button" parent="TextAppearance.Material3.LabelLarge">
        <item name="android:fontFamily">@font/leef_sans</item>
        <item name="fontFamily">@font/leef_sans</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">16sp</item>
        <item name="android:letterSpacing">0</item>
        <item name="android:textAllCaps">false</item>
    </style>

    <style name="TextAppearance.LEEF.Button.Large">
        <item name="android:textSize">17sp</item>
    </style>

    <!-- Onboarding -->
    <style name="TextAppearance.LEEF.Onboarding.HeroSubtitle" parent="TextAppearance.LEEF.TitleLarge">
        <item name="android:textSize">@dimen/onboarding_hero_subtitle_size</item>
        <item name="android:textColor">@color/leef_ink</item>
        <item name="lineHeight">@dimen/onboarding_hero_subtitle_line_height</item>
    </style>

    <style name="TextAppearance.LEEF.Onboarding.Headline" parent="TextAppearance.LEEF.HeadlineSmall">
        <item name="android:textSize">26sp</item>
        <item name="android:textColor">@color/leef_green_900</item>
        <item name="android:letterSpacing">-0.01</item>
        <item name="lineHeight">34sp</item>
    </style>

    <style name="TextAppearance.LEEF.Onboarding.Body" parent="TextAppearance.LEEF.BodyLarge">
        <item name="android:textSize">15sp</item>
        <item name="android:textColor">@color/leef_gray_700</item>
        <item name="lineHeight">23sp</item>
    </style>

    <style name="TextAppearance.LEEF.Onboarding.Prompt" parent="TextAppearance.LEEF.BodyMedium">
        <item name="android:textSize">14sp</item>
        <item name="android:textColor">@color/leef_gray_600</item>
    </style>

    <style name="TextAppearance.LEEF.Onboarding.PromptAction" parent="TextAppearance.LEEF.Onboarding.Prompt">
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/leef_green_800</item>
    </style>
</resources>
