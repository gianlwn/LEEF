<?xml version="1.0" encoding="utf-8"?>
<!-- Brand font family: Plus Jakarta Sans (SIL Open Font License, see assets/licenses).
     To switch typefaces, replace the leef_sans_*.ttf files and keep the same file names. -->
<font-family xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <font
        android:font="@font/leef_sans_regular"
        android:fontStyle="normal"
        android:fontWeight="400"
        app:font="@font/leef_sans_regular"
        app:fontStyle="normal"
        app:fontWeight="400" />
    <font
        android:font="@font/leef_sans_medium"
        android:fontStyle="normal"
        android:fontWeight="500"
        app:font="@font/leef_sans_medium"
        app:fontStyle="normal"
        app:fontWeight="500" />
    <font
        android:font="@font/leef_sans_semibold"
        android:fontStyle="normal"
        android:fontWeight="600"
        app:font="@font/leef_sans_semibold"
        app:fontStyle="normal"
        app:fontWeight="600" />
    <font
        android:font="@font/leef_sans_bold"
        android:fontStyle="normal"
        android:fontWeight="700"
        app:font="@font/leef_sans_bold"
        app:fontStyle="normal"
        app:fontWeight="700" />
    <font
        android:font="@font/leef_sans_extrabold"
        android:fontStyle="normal"
        android:fontWeight="800"
        app:font="@font/leef_sans_extrabold"
        app:fontStyle="normal"
        app:fontWeight="800" />
</font-family>
