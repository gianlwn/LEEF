<?xml version="1.0" encoding="utf-8"?>
<!-- Screen 6 - Event Details. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/detailsRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/leef_background"
    android:orientation="vertical">

    <!-- Top bar: back, heart, share -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="8dp"
        android:paddingTop="4dp"
        android:paddingEnd="12dp"
        android:paddingBottom="4dp">

        <ImageButton
            android:id="@+id/backButton"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/search_back_a11y"
            android:padding="12dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_arrow_back"
            app:tint="@color/leef_ink" />

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <ImageButton
            android:id="@+id/heart"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:padding="12dp"
            android:scaleType="fitCenter"
            android:src="@drawable/selector_heart"
            android:visibility="invisible"
            tools:contentDescription="Save event"
            tools:visibility="visible" />

        <ImageButton
            android:id="@+id/share"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/details_share_a11y"
            android:padding="12dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_share"
            android:visibility="invisible"
            app:tint="@color/leef_ink"
            tools:visibility="visible" />
    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <ScrollView
            android:id="@+id/scroll"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:overScrollMode="never"
            android:visibility="gone"
            tools:visibility="visible">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingBottom="20dp">

                <!-- Photo with the category badge straddling its bottom edge -->
                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingBottom="18dp">

                    <FrameLayout
                        android:layout_width="match_parent"
                        android:layout_height="210dp">

                        <com.itismob.s03.group7.leef.ui.widget.ArtSlotView
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            app:leefArtName="art_event_cover_default"
                            app:leefArtScale="centerCrop"
                            app:leefArtTitle="@string/art_title_event_cover_default" />

                        <ImageView
                            android:id="@+id/coverPhoto"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:importantForAccessibility="no"
                            android:scaleType="centerCrop"
                            android:visibility="gone" />
                    </FrameLayout>

                    <TextView
                        android:id="@+id/badge"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="bottom|start"
                        android:layout_marginStart="20dp"
                        android:layout_marginBottom="14dp"
                        android:background="@drawable/bg_event_badge"
                        android:paddingStart="18dp"
                        android:paddingTop="8dp"
                        android:paddingEnd="18dp"
                        android:paddingBottom="8dp"
                        android:textAppearance="@style/TextAppearance.LEEF.Event.Badge"
                        tools:text="Seminar" />
                </FrameLayout>

                <TextView
                    android:id="@+id/cancelledBanner"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="20dp"
                    android:layout_marginTop="4dp"
                    android:layout_marginEnd="20dp"
                    android:layout_marginBottom="12dp"
                    android:background="@drawable/bg_status_saved"
                    android:padding="12dp"
                    android:text="@string/details_cancelled_banner"
                    android:textColor="@color/leef_error"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:visibility="gone"
                    tools:visibility="visible" />

                <TextView
                    android:id="@+id/title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingStart="20dp"
                    android:paddingEnd="20dp"
                    android:textAppearance="@style/TextAppearance.LEEF.Details.Title"
                    tools:text="Future-Ready: AI for Students" />

                <!-- Average stars; only shown once someone has rated the event. -->
                <TextView
                    android:id="@+id/ratingText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="20dp"
                    android:layout_marginTop="6dp"
                    android:drawablePadding="8dp"
                    android:drawableStart="@drawable/ic_star_filled"
                    android:gravity="center_vertical"
                    android:textAppearance="@style/TextAppearance.LEEF.Details.Label"
                    android:visibility="gone"
                    tools:text="4.6 (12 ratings)"
                    tools:visibility="visible" />

                <TextView
                    android:id="@+id/description"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingStart="20dp"
                    android:paddingTop="8dp"
                    android:paddingEnd="20dp"
                    android:textAppearance="@style/TextAppearance.LEEF.Details.Summary"
                    tools:text="A hands-on seminar on using AI tools for academic productivity and creativity." />

                <!-- Date and time -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:paddingStart="20dp"
                    android:paddingTop="24dp"
                    android:paddingEnd="20dp">

                    <ImageView
                        android:layout_width="28dp"
                        android:layout_height="28dp"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_event_date"
                        app:tint="@color/leef_ink" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="16dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/dateText"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textAppearance="@style/TextAppearance.LEEF.Details.Line"
                            tools:text="Sat, Oct 18, 2026" />

                        <TextView
                            android:id="@+id/timeText"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:textAppearance="@style/TextAppearance.LEEF.Details.Line"
                            tools:text="9:00 AM – 4:00 PM" />
                    </LinearLayout>
                </LinearLayout>

                <!-- Venue and View Map -->
                <LinearLayout
                    android:id="@+id/venueRow"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="20dp"
                    android:paddingTop="22dp"
                    android:paddingEnd="20dp">

                    <ImageView
                        android:layout_width="28dp"
                        android:layout_height="28dp"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_event_pin"
                        app:tint="@color/leef_ink" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="16dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/venueText"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textAppearance="@style/TextAppearance.LEEF.Details.Line"
                            tools:text="Ateneo de Manila University" />

                        <TextView
                            android:id="@+id/areaText"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:textAppearance="@style/TextAppearance.LEEF.Details.Line"
                            tools:text="Katipunan, Quezon City" />
                    </LinearLayout>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/viewMapButton"
                        style="@style/Widget.LEEF.Button.Tonal"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:text="@string/details_view_map" />
                </LinearLayout>

                <!-- Organizer -->
                <LinearLayout
                    android:id="@+id/organizerRow"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="20dp"
                    android:paddingTop="22dp"
                    android:paddingEnd="20dp">

                    <FrameLayout
                        android:layout_width="58dp"
                        android:layout_height="58dp"
                        android:background="@drawable/bg_avatar_ring">

                        <TextView
                            android:id="@+id/organizerInitials"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:gravity="center"
                            android:importantForAccessibility="no"
                            android:textAppearance="@style/TextAppearance.LEEF.TitleMedium"
                            android:textColor="@color/leef_green_900"
                            android:textStyle="bold"
                            tools:text="AI" />

                        <ImageView
                            android:id="@+id/organizerLogo"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:importantForAccessibility="no"
                            android:scaleType="centerCrop"
                            android:visibility="gone" />
                    </FrameLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="16dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/details_organized_by"
                            android:textAppearance="@style/TextAppearance.LEEF.Details.Label" />

                        <TextView
                            android:id="@+id/organizerName"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:textAppearance="@style/TextAppearance.LEEF.Details.Organizer"
                            tools:text="Ateneo Innovation Center" />
                    </LinearLayout>

                    <!-- Opens a private chat with the organizer; hidden on your own events. -->
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/messageOrganizerButton"
                        style="@style/Widget.LEEF.Button.Tonal"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:text="@string/details_message_organizer"
                        android:visibility="gone"
                        tools:visibility="visible" />
                </LinearLayout>

                <!-- Tags -->
                <com.google.android.material.chip.ChipGroup
                    android:id="@+id/tags"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="20dp"
                    android:layout_marginTop="20dp"
                    android:layout_marginEnd="20dp"
                    app:chipSpacingHorizontal="10dp"
                    app:chipSpacingVertical="10dp" />

                <!-- Flyers and files the organizer linked to -->
                <LinearLayout
                    android:id="@+id/filesBlock"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingStart="20dp"
                    android:paddingTop="20dp"
                    android:paddingEnd="20dp"
                    android:visibility="gone"
                    tools:visibility="visible">

                    <TextView
                        android:id="@+id/filesTitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/details_files_title"
                        android:textAppearance="@style/TextAppearance.LEEF.Details.Line" />

                    <LinearLayout
                        android:id="@+id/fileList"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical" />
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginStart="20dp"
                    android:layout_marginTop="22dp"
                    android:layout_marginEnd="20dp"
                    android:background="@color/leef_outline" />

                <!-- Pricing: the early-bird price beside the regular rate, or a single price -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:paddingStart="20dp"
                    android:paddingTop="18dp"
                    android:paddingEnd="20dp"
                    android:paddingBottom="4dp">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="center_horizontal"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/priceMain"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textAppearance="@style/TextAppearance.LEEF.Details.PriceMain"
                            tools:text="₱350" />

                        <TextView
                            android:id="@+id/priceMainCaption"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:textAppearance="@style/TextAppearance.LEEF.Details.PriceCaption"
                            tools:text="Early bird (until Oct 1)" />
                    </LinearLayout>

                    <View
                        android:id="@+id/priceDivider"
                        android:layout_width="1dp"
                        android:layout_height="64dp"
                        android:layout_gravity="center_vertical"
                        android:background="@drawable/bg_price_divider"
                        android:visibility="gone"
                        tools:visibility="visible" />

                    <LinearLayout
                        android:id="@+id/priceSecondGroup"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center_vertical"
                        android:layout_weight="1"
                        android:gravity="center_horizontal"
                        android:orientation="vertical"
                        android:visibility="gone"
                        tools:visibility="visible">

                        <TextView
                            android:id="@+id/priceSecond"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textAppearance="@style/TextAppearance.LEEF.Details.PriceSecond"
                            tools:text="₱500" />

                        <TextView
                            android:id="@+id/priceSecondCaption"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:textAppearance="@style/TextAppearance.LEEF.Details.PriceCaption"
                            tools:text="Regular Rate" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>
        </ScrollView>

        <com.google.android.material.progressindicator.CircularProgressIndicator
            android:id="@+id/loading"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:contentDescription="@string/details_loading_a11y"
            android:indeterminate="true"
            app:indicatorColor="@color/leef_green_700" />

        <!-- Couldn't load -->
        <LinearLayout
            android:id="@+id/errorGroup"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingStart="36dp"
            android:paddingEnd="36dp"
            android:visibility="gone">

            <ImageView
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_state_cloud_off"
                app:tint="@color/leef_gray_500" />

            <TextView
                android:id="@+id/errorText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:gravity="center"
                android:textAppearance="@style/TextAppearance.LEEF.Home.StateBody"
                tools:text="We couldn't load events right now. Please try again." />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/retryButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:minWidth="170dp"
                android:text="@string/home_retry" />
        </LinearLayout>

        <!-- The event is gone -->
        <LinearLayout
            android:id="@+id/notFoundGroup"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingStart="36dp"
            android:paddingEnd="36dp"
            android:visibility="gone">

            <com.itismob.s03.group7.leef.ui.widget.ArtSlotView
                android:layout_width="220dp"
                android:layout_height="174dp"
                app:leefArtName="art_home_empty"
                app:leefArtTitle="@string/art_title_home_empty" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:gravity="center"
                android:text="@string/details_not_found_title"
                android:textAppearance="@style/TextAppearance.LEEF.Home.StateTitle" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center"
                android:text="@string/details_not_found_body"
                android:textAppearance="@style/TextAppearance.LEEF.Home.StateBody" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/notFoundBackButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:minWidth="170dp"
                android:text="@string/details_go_back" />
        </LinearLayout>
    </FrameLayout>

    <!-- Register Now, always in reach (organizers also get Promote) -->
    <LinearLayout
        android:id="@+id/bottomBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingTop="8dp"
        android:paddingEnd="20dp"
        android:paddingBottom="12dp"
        android:visibility="gone"
        tools:visibility="visible">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/promoteButton"
            style="@style/Widget.LEEF.Button.Tonal"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginBottom="10dp"
            android:text="@string/details_promote"
            android:visibility="gone"
            tools:visibility="visible" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/registerButton"
            style="@style/Widget.LEEF.Button"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/details_register" />
    </LinearLayout>
</LinearLayout>
