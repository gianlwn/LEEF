<?xml version="1.0" encoding="utf-8"?>
<!-- Screen 8 - My Events Dashboard. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/leef_background"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="20dp"
        android:paddingTop="16dp"
        android:paddingEnd="20dp">

        <TextView
            android:id="@+id/title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/my_events_title"
            android:textAppearance="@style/TextAppearance.LEEF.Details.Title" />

        <!-- Only organizer accounts see this (Screen 11). -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/postEventButton"
            style="@style/Widget.LEEF.Button.Tonal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/my_events_post"
            android:visibility="gone"
            app:icon="@drawable/ic_plus"
            app:iconSize="18dp"
            app:iconTint="@color/leef_green_900"
            tools:visibility="visible" />
    </LinearLayout>

    <!-- Only organizer accounts see this: the events they posted. -->
    <LinearLayout
        android:id="@+id/postedRow"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="20dp"
        android:layout_marginTop="12dp"
        android:layout_marginEnd="20dp"
        android:background="@drawable/bg_info_card"
        android:clickable="true"
        android:focusable="true"
        android:foreground="?attr/selectableItemBackground"
        android:gravity="center_vertical"
        android:minHeight="56dp"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingEnd="12dp"
        android:visibility="gone"
        tools:visibility="visible">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/my_events_manage_posted"
            android:textAppearance="@style/TextAppearance.LEEF.Registration.RowTitle" />

        <ImageView
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_chevron_right"
            app:tint="@color/leef_gray_500" />
    </LinearLayout>

    <!-- Only organizer accounts see this: the receipts of their boosts. -->
    <LinearLayout
        android:id="@+id/boostHistoryRow"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="20dp"
        android:layout_marginTop="8dp"
        android:layout_marginEnd="20dp"
        android:background="@drawable/bg_info_card"
        android:clickable="true"
        android:focusable="true"
        android:foreground="?attr/selectableItemBackground"
        android:gravity="center_vertical"
        android:minHeight="56dp"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingEnd="12dp"
        android:visibility="gone"
        tools:visibility="visible">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/my_events_boost_history"
            android:textAppearance="@style/TextAppearance.LEEF.Registration.RowTitle" />

        <ImageView
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_chevron_right"
            app:tint="@color/leef_gray_500" />
    </LinearLayout>

    <!-- Upcoming / Past switch -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="20dp"
        android:layout_marginTop="16dp"
        android:layout_marginEnd="20dp"
        android:background="@drawable/bg_segment_track"
        android:orientation="horizontal"
        android:padding="4dp">

        <TextView
            android:id="@+id/tabUpcoming"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:background="@drawable/bg_segment_tab"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:text="@string/my_events_tab_upcoming"
            android:textAppearance="@style/TextAppearance.LEEF.Registration.RowTitle"
            android:textColor="@color/selector_segment_text" />

        <TextView
            android:id="@+id/tabPast"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:background="@drawable/bg_segment_tab"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:text="@string/my_events_tab_past"
            android:textAppearance="@style/TextAppearance.LEEF.Registration.RowTitle"
            android:textColor="@color/selector_segment_text" />
    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="4dp"
        android:layout_weight="1">

        <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
            android:id="@+id/swipeRefresh"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone"
            tools:visibility="visible">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/list"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipToPadding="false"
                android:overScrollMode="never"
                android:paddingStart="20dp"
                android:paddingEnd="20dp"
                android:paddingBottom="8dp" />
        </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>

        <ProgressBar
            android:id="@+id/loading"
            style="?android:attr/progressBarStyle"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_gravity="center"
            android:contentDescription="@string/my_events_loading_a11y"
            android:indeterminateTint="@color/leef_green_700" />

        <!-- Couldn't load -->
        <LinearLayout
            android:id="@+id/errorGroup"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingStart="36dp"
            android:paddingEnd="36dp"
            android:visibility="gone">

            <ImageView
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_state_cloud_off"
                app:tint="@color/leef_gray_500" />

            <TextView
                android:id="@+id/errorText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:gravity="center"
                android:textAppearance="@style/TextAppearance.LEEF.Home.StateBody"
                tools:text="We couldn't load events right now. Please try again." />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/retryButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:minWidth="170dp"
                android:text="@string/home_retry" />
        </LinearLayout>

        <!-- Nothing on this tab -->
        <LinearLayout
            android:id="@+id/emptyGroup"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingStart="36dp"
            android:paddingEnd="36dp"
            android:visibility="gone">

            <com.itismob.s03.group7.leef.ui.widget.ArtSlotView
                android:layout_width="220dp"
                android:layout_height="174dp"
                app:leefArtName="art_home_empty"
                app:leefArtTitle="@string/art_title_home_empty" />

            <TextView
                android:id="@+id/emptyTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:gravity="center"
                android:textAppearance="@style/TextAppearance.LEEF.Home.StateTitle"
                tools:text="No upcoming events yet" />

            <TextView
                android:id="@+id/emptyBody"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center"
                android:textAppearance="@style/TextAppearance.LEEF.Home.StateBody"
                tools:text="Register for an event, or tap the heart to save one." />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/exploreButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:minWidth="170dp"
                android:text="@string/my_events_explore" />
        </LinearLayout>
    </FrameLayout>
</LinearLayout>
