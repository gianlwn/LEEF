<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/leef_background"
    tools:context=".auth.VerifyEmailActivity">

    <ScrollView
        android:id="@+id/scroll"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:overScrollMode="never"
        android:scrollbars="none">

        <FrameLayout
            android:id="@+id/scrollContent"
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <!-- Corner leaves: decoration only (same artwork as Create Account). -->
            <com.itismob.s03.group7.leef.ui.widget.ArtSlotView
                android:id="@+id/leafTopLeft"
                android:layout_width="140dp"
                android:layout_height="140dp"
                android:layout_gravity="top|start"
                android:layout_marginTop="8dp"
                app:leefArtName="art_auth_leaf_top_left"
                app:leefArtTitle="@string/art_title_auth_leaf_top_left" />

            <com.itismob.s03.group7.leef.ui.widget.ArtSlotView
                android:id="@+id/leafBottomRight"
                android:layout_width="140dp"
                android:layout_height="140dp"
                android:layout_gravity="bottom|end"
                app:leefArtName="art_auth_leaf_bottom_right"
                app:leefArtTitle="@string/art_title_auth_leaf_bottom_right" />

            <LinearLayout
                android:id="@+id/content"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="24dp"
                android:paddingEnd="24dp"
                android:paddingTop="72dp"
                android:paddingBottom="32dp">

                <com.itismob.s03.group7.leef.ui.widget.ArtSlotView
                    android:id="@+id/art"
                    android:layout_width="220dp"
                    android:layout_height="220dp"
                    android:layout_gravity="center_horizontal"
                    app:leefArtName="art_verify_email"
                    app:leefArtTitle="@string/art_title_verify_email" />

                <TextView
                    android:id="@+id/title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:gravity="center"
                    android:text="@string/verify_title"
                    android:textAppearance="@style/TextAppearance.LEEF.Auth.Title" />

                <TextView
                    android:id="@+id/sentTo"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:gravity="center"
                    android:text="@string/verify_sent_to"
                    android:textAppearance="@style/TextAppearance.LEEF.Auth.Subtitle" />

                <TextView
                    android:id="@+id/emailText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:gravity="center"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:textAppearance="@style/TextAppearance.LEEF.Auth.Email"
                    tools:text="name@school.edu.ph" />

                <TextView
                    android:id="@+id/hint"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:gravity="center"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:text="@string/verify_hint"
                    android:textAppearance="@style/TextAppearance.LEEF.Auth.Subtitle" />

                <TextView
                    android:id="@+id/statusText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:accessibilityLiveRegion="polite"
                    android:gravity="center"
                    android:textAppearance="@style/TextAppearance.LEEF.Auth.FieldError"
                    android:visibility="gone"
                    tools:text="We haven't seen your verification yet."
                    tools:visibility="visible" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/continueButton"
                    style="@style/Widget.LEEF.Button.Hero"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="24dp"
                    android:text="@string/verify_continue"
                    app:iconGravity="textStart" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/resendButton"
                    style="@style/Widget.LEEF.Button.TextButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="@string/verify_resend" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/changeEmailButton"
                    style="@style/Widget.LEEF.Button.TextButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/verify_change_email"
                    android:textColor="@color/leef_gray_600" />
            </LinearLayout>
        </FrameLayout>
    </ScrollView>
</FrameLayout>
