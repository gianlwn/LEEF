<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/leef_background"
    tools:context=".auth.CreateAccountActivity">

    <ScrollView
        android:id="@+id/scroll"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:overScrollMode="never"
        android:scrollbars="none">

        <FrameLayout
            android:id="@+id/scrollContent"
            android:layout_width="match_parent"
            android:layout_height="match_parent">

        <!-- Corner leaves: decoration only; they scroll away with the form. -->
        <com.itismob.s03.group7.leef.ui.widget.ArtSlotView
            android:id="@+id/leafTopLeft"
            android:layout_width="140dp"
            android:layout_height="140dp"
            android:layout_gravity="top|start"
            android:layout_marginTop="8dp"
            app:leefArtName="art_auth_leaf_top_left"
            app:leefArtTitle="@string/art_title_auth_leaf_top_left" />

        <com.itismob.s03.group7.leef.ui.widget.ArtSlotView
            android:id="@+id/leafTopRight"
            android:layout_width="140dp"
            android:layout_height="140dp"
            android:layout_gravity="top|end"
            android:layout_marginTop="8dp"
            app:leefArtName="art_auth_leaf_top_right"
            app:leefArtTitle="@string/art_title_auth_leaf_top_right" />

        <com.itismob.s03.group7.leef.ui.widget.ArtSlotView
            android:id="@+id/leafBottomRight"
            android:layout_width="140dp"
            android:layout_height="140dp"
            android:layout_gravity="bottom|end"
            app:leefArtName="art_auth_leaf_bottom_right"
            app:leefArtTitle="@string/art_title_auth_leaf_bottom_right" />

        <LinearLayout
            android:id="@+id/content"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="24dp"
            android:paddingEnd="24dp"
            android:paddingTop="80dp"
            android:paddingBottom="32dp">

            <TextView
                android:id="@+id/title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:contentDescription="@string/auth_create_title_a11y"
                android:gravity="center"
                android:text="@string/auth_create_title"
                android:textAppearance="@style/TextAppearance.LEEF.Auth.Title" />

            <TextView
                android:id="@+id/subtitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:gravity="center"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:text="@string/auth_create_subtitle"
                android:textAppearance="@style/TextAppearance.LEEF.Auth.Subtitle" />

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/nameLayout"
                style="@style/Widget.LEEF.TextInputLayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="28dp"
                android:hint="@string/auth_hint_full_name"
                app:startIconDrawable="@drawable/ic_field_person">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/nameInput"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:autofillHints="name"
                    android:imeOptions="actionNext"
                    android:inputType="textPersonName|textCapWords"
                    android:maxLength="80"
                    android:maxLines="1"
                    android:textAppearance="?attr/textAppearanceBodyLarge" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/schoolLayout"
                style="@style/Widget.LEEF.TextInputLayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:hint="@string/auth_hint_school"
                app:startIconDrawable="@drawable/ic_field_school">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/schoolInput"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:imeOptions="actionNext"
                    android:inputType="textCapWords"
                    android:maxLength="100"
                    android:maxLines="1"
                    android:textAppearance="?attr/textAppearanceBodyLarge" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/emailLayout"
                style="@style/Widget.LEEF.TextInputLayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:hint="@string/auth_hint_email"
                app:startIconDrawable="@drawable/ic_field_mail">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/emailInput"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:autofillHints="emailAddress"
                    android:imeOptions="actionNext"
                    android:inputType="textEmailAddress"
                    android:maxLines="1"
                    android:textAppearance="?attr/textAppearanceBodyLarge" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/passwordLayout"
                style="@style/Widget.LEEF.TextInputLayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:hint="@string/auth_hint_password"
                app:endIconMode="password_toggle"
                app:helperText="@string/auth_password_helper"
                app:startIconDrawable="@drawable/ic_field_lock">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/passwordInput"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:autofillHints="newPassword"
                    android:imeOptions="actionDone"
                    android:inputType="textPassword"
                    android:maxLines="1"
                    android:textAppearance="?attr/textAppearanceBodyLarge" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/roleLayout"
                style="@style/Widget.LEEF.TextInputLayout.Dropdown"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:hint="@string/auth_hint_role"
                app:startIconDrawable="@drawable/ic_field_role">

                <!-- saveEnabled=false: the screen restores the chosen role itself, because a restored
                     read-only dropdown would otherwise list only the selected option. -->
                <com.google.android.material.textfield.MaterialAutoCompleteTextView
                    android:id="@+id/roleInput"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="none"
                    android:saveEnabled="false"
                    android:textAppearance="?attr/textAppearanceBodyLarge" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.checkbox.MaterialCheckBox
                android:id="@+id/termsCheck"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:paddingStart="8dp"
                android:paddingEnd="0dp"
                android:textAppearance="@style/TextAppearance.LEEF.Auth.Terms" />

            <TextView
                android:id="@+id/termsError"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:accessibilityLiveRegion="polite"
                android:text="@string/auth_error_terms_required"
                android:textAppearance="@style/TextAppearance.LEEF.Auth.FieldError"
                android:visibility="gone"
                tools:visibility="visible" />

            <TextView
                android:id="@+id/formError"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:accessibilityLiveRegion="polite"
                android:gravity="center"
                android:textAppearance="@style/TextAppearance.LEEF.Auth.FieldError"
                android:visibility="gone"
                tools:text="No internet connection. Check your connection and try again."
                tools:visibility="visible" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/createButton"
                style="@style/Widget.LEEF.Button.Hero"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="@string/auth_create_account"
                app:iconGravity="textStart" />

            <LinearLayout
                android:id="@+id/loginRow"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="20dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:clickable="true"
                android:contentDescription="@string/auth_log_in_a11y"
                android:focusable="true"
                android:gravity="center"
                android:minHeight="48dp"
                android:orientation="horizontal"
                android:paddingStart="8dp"
                android:paddingEnd="8dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/auth_have_account"
                    android:textAppearance="@style/TextAppearance.LEEF.Auth.Prompt" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:text="@string/auth_log_in"
                    android:textAppearance="@style/TextAppearance.LEEF.Auth.PromptAction" />
            </LinearLayout>
        </LinearLayout>
        </FrameLayout>
    </ScrollView>
</FrameLayout>
