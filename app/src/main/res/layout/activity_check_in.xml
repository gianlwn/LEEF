<?xml version="1.0" encoding="utf-8"?>
<!-- Screen 9 - Check-in: the ticket with the QR code. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/checkInRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/leef_background"
    android:orientation="vertical">

    <!-- Top bar: back and title -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="8dp"
        android:paddingTop="4dp"
        android:paddingEnd="20dp"
        android:paddingBottom="4dp">

        <ImageButton
            android:id="@+id/backButton"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/search_back_a11y"
            android:padding="12dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_arrow_back"
            app:tint="@color/leef_ink" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:layout_weight="1"
            android:text="@string/check_in_title"
            android:textAppearance="@style/TextAppearance.LEEF.Home.Name" />
    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <!-- The ticket -->
        <ScrollView
            android:id="@+id/ticketScroll"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:overScrollMode="never"
            android:visibility="gone"
            tools:visibility="visible">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="20dp"
                android:paddingTop="8dp"
                android:paddingEnd="20dp"
                android:paddingBottom="24dp">

                <!-- The event -->
                <TextView
                    android:id="@+id/eventTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:textAppearance="@style/TextAppearance.LEEF.Details.Organizer"
                    tools:text="Future-Ready: AI for Students" />

                <TextView
                    android:id="@+id/eventWhen"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:gravity="center"
                    android:textAppearance="@style/TextAppearance.LEEF.Details.Label"
                    tools:text="Oct 18, 2026 | 9:00 AM" />

                <TextView
                    android:id="@+id/eventWhere"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:gravity="center"
                    android:textAppearance="@style/TextAppearance.LEEF.Details.Label"
                    tools:text="Ateneo de Manila University" />

                <!-- The pass -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:background="@drawable/bg_info_card"
                    android:gravity="center_horizontal"
                    android:orientation="vertical"
                    android:paddingStart="20dp"
                    android:paddingTop="28dp"
                    android:paddingEnd="20dp"
                    android:paddingBottom="28dp">

                    <ImageView
                        android:id="@+id/qrImage"
                        android:layout_width="232dp"
                        android:layout_height="232dp"
                        android:background="@color/white"
                        android:contentDescription="@string/check_in_qr_a11y"
                        android:scaleType="fitCenter" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="22dp"
                        android:gravity="center"
                        android:text="@string/check_in_ready"
                        android:textAppearance="@style/TextAppearance.LEEF.Details.Title" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:gravity="center"
                        android:text="@string/check_in_show_qr"
                        android:textAppearance="@style/TextAppearance.LEEF.Home.StateBody" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginTop="22dp"
                        android:layout_marginBottom="22dp"
                        android:background="@drawable/bg_price_divider" />

                    <TextView
                        android:id="@+id/attendeeName"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:textAppearance="@style/TextAppearance.LEEF.Details.Organizer"
                        tools:text="Alex Santos" />

                    <TextView
                        android:id="@+id/confirmationCode"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:gravity="center"
                        android:letterSpacing="0.06"
                        android:textAppearance="@style/TextAppearance.LEEF.Details.Line"
                        android:textIsSelectable="true"
                        tools:text="#LEEF-7KQ2MD" />

                    <TextView
                        android:id="@+id/ticketLine"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:gravity="center"
                        android:textAppearance="@style/TextAppearance.LEEF.Details.Label"
                        tools:text="Early Bird" />
                </LinearLayout>
            </LinearLayout>
        </ScrollView>

        <ProgressBar
            android:id="@+id/loading"
            style="?android:attr/progressBarStyle"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_gravity="center"
            android:contentDescription="@string/check_in_loading_a11y"
            android:indeterminateTint="@color/leef_green_700" />

        <!-- Couldn't load -->
        <LinearLayout
            android:id="@+id/errorGroup"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingStart="36dp"
            android:paddingEnd="36dp"
            android:visibility="gone">

            <ImageView
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_state_cloud_off"
                app:tint="@color/leef_gray_500" />

            <TextView
                android:id="@+id/errorText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:gravity="center"
                android:textAppearance="@style/TextAppearance.LEEF.Home.StateBody"
                tools:text="We couldn't load events right now. Please try again." />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/retryButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:minWidth="170dp"
                android:text="@string/home_retry" />
        </LinearLayout>

        <!-- No registration for this event -->
        <LinearLayout
            android:id="@+id/notRegisteredGroup"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingStart="36dp"
            android:paddingEnd="36dp"
            android:visibility="gone">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="@string/check_in_not_registered_title"
                android:textAppearance="@style/TextAppearance.LEEF.Home.StateTitle" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center"
                android:text="@string/check_in_not_registered_body"
                android:textAppearance="@style/TextAppearance.LEEF.Home.StateBody" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/viewEventButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:minWidth="170dp"
                android:text="@string/check_in_view_event" />
        </LinearLayout>

        <!-- The event is over -->
        <LinearLayout
            android:id="@+id/endedGroup"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingStart="36dp"
            android:paddingEnd="36dp"
            android:visibility="gone">

            <ImageView
                android:id="@+id/endedIcon"
                android:layout_width="72dp"
                android:layout_height="72dp"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_check_circle" />

            <TextView
                android:id="@+id/endedTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:gravity="center"
                android:text="@string/check_in_ended_title"
                android:textAppearance="@style/TextAppearance.LEEF.Home.StateTitle" />

            <TextView
                android:id="@+id/endedBody"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center"
                android:text="@string/check_in_ended_body"
                android:textAppearance="@style/TextAppearance.LEEF.Home.StateBody" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/endedBackButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:minWidth="170dp"
                android:text="@string/details_go_back" />
        </LinearLayout>
    </FrameLayout>
</LinearLayout>
