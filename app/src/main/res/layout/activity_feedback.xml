<?xml version="1.0" encoding="utf-8"?>
<!-- Screen 12 - Event Feedback. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/feedbackRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/leef_background"
    android:orientation="vertical"
    tools:context=".feedback.FeedbackActivity">

    <!-- Top bar: back and title -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="8dp"
        android:paddingTop="4dp"
        android:paddingEnd="20dp"
        android:paddingBottom="4dp">

        <ImageButton
            android:id="@+id/backButton"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/search_back_a11y"
            android:padding="12dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_arrow_back"
            app:tint="@color/leef_ink" />

        <TextView
            android:id="@+id/screenTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:layout_weight="1"
            android:text="@string/feedback_title"
            android:textAppearance="@style/TextAppearance.LEEF.Home.Name" />
    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <ScrollView
            android:id="@+id/formScroll"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:overScrollMode="never"
            android:visibility="gone"
            tools:visibility="visible">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="20dp"
                android:paddingEnd="20dp"
                android:paddingBottom="28dp">

                <!-- The event being rated -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:paddingTop="8dp">

                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="96dp"
                        android:layout_height="96dp"
                        app:cardBackgroundColor="@color/leef_green_100"
                        app:cardCornerRadius="16dp"
                        app:cardElevation="0dp"
                        app:strokeWidth="0dp">

                        <com.itismob.s03.group7.leef.ui.widget.ArtSlotView
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            app:leefArtName="art_event_cover_default"
                            app:leefArtScale="centerCrop"
                            app:leefArtTitle="@string/art_title_event_cover_default" />

                        <ImageView
                            android:id="@+id/coverPhoto"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:importantForAccessibility="no"
                            android:scaleType="centerCrop"
                            android:visibility="gone" />
                    </com.google.android.material.card.MaterialCardView>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center_vertical"
                        android:layout_marginStart="16dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/eventTitle"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:ellipsize="end"
                            android:maxLines="2"
                            android:textAppearance="@style/TextAppearance.LEEF.Event.RowTitle"
                            tools:text="Future-Ready: AI for Students" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <ImageView
                                android:layout_width="18dp"
                                android:layout_height="18dp"
                                android:importantForAccessibility="no"
                                android:src="@drawable/ic_event_date"
                                app:tint="@color/leef_gray_700" />

                            <TextView
                                android:id="@+id/eventDate"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="8dp"
                                android:layout_weight="1"
                                android:ellipsize="end"
                                android:maxLines="1"
                                android:textAppearance="@style/TextAppearance.LEEF.Event.Meta"
                                tools:text="Oct 18, 2026" />
                        </LinearLayout>

                        <LinearLayout
                            android:id="@+id/eventPlaceRow"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <ImageView
                                android:layout_width="18dp"
                                android:layout_height="18dp"
                                android:importantForAccessibility="no"
                                android:src="@drawable/ic_event_pin"
                                app:tint="@color/leef_gray_700" />

                            <TextView
                                android:id="@+id/eventPlace"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="8dp"
                                android:layout_weight="1"
                                android:ellipsize="end"
                                android:maxLines="1"
                                android:textAppearance="@style/TextAppearance.LEEF.Event.Meta"
                                tools:text="Ateneo de Manila University" />
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>

                <TextView
                    android:id="@+id/questionTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="28dp"
                    android:text="@string/feedback_question"
                    android:textAppearance="@style/TextAppearance.LEEF.Registration.Section" />

                <com.itismob.s03.group7.leef.ui.widget.StarRatingBar
                    android:id="@+id/starBar"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp" />

                <TextView
                    android:id="@+id/ratingError"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:accessibilityLiveRegion="polite"
                    android:gravity="center"
                    android:text="@string/feedback_error_rating"
                    android:textAppearance="@style/TextAppearance.LEEF.Auth.FieldError"
                    android:visibility="gone"
                    tools:visibility="visible" />

                <com.google.android.material.chip.ChipGroup
                    android:id="@+id/tagGroup"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    app:chipSpacingHorizontal="10dp"
                    app:chipSpacingVertical="8dp" />

                <TextView
                    android:id="@+id/commentTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="28dp"
                    android:text="@string/feedback_label_comment"
                    android:textAppearance="@style/TextAppearance.LEEF.Registration.Section" />

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/commentLayout"
                    style="@style/Widget.LEEF.TextInputLayout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    app:counterEnabled="true"
                    app:counterMaxLength="300"
                    app:hintEnabled="false">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/commentInput"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="top|start"
                        android:hint="@string/feedback_hint_comment"
                        android:inputType="textCapSentences|textMultiLine"
                        android:maxLength="300"
                        android:minLines="4"
                        android:textAppearance="?attr/textAppearanceBodyLarge" />
                </com.google.android.material.textfield.TextInputLayout>

                <TextView
                    android:id="@+id/photoTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="24dp"
                    android:text="@string/feedback_label_photo"
                    android:textAppearance="@style/TextAppearance.LEEF.Registration.Section" />

                <FrameLayout
                    android:id="@+id/photoCard"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:background="@drawable/bg_filter_field"
                    android:clickable="true"
                    android:contentDescription="@string/feedback_photo_add"
                    android:focusable="true"
                    android:minHeight="64dp">

                    <LinearLayout
                        android:id="@+id/photoEmpty"
                        android:layout_width="match_parent"
                        android:layout_height="64dp"
                        android:gravity="center"
                        android:orientation="horizontal">

                        <ImageView
                            android:layout_width="28dp"
                            android:layout_height="28dp"
                            android:importantForAccessibility="no"
                            android:src="@drawable/ic_image_placeholder"
                            app:tint="@color/leef_ink" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="14dp"
                            android:text="@string/feedback_photo_add"
                            android:textAppearance="@style/TextAppearance.LEEF.Home.Hint" />
                    </LinearLayout>

                    <ImageView
                        android:id="@+id/photoPreview"
                        android:layout_width="match_parent"
                        android:layout_height="160dp"
                        android:background="@drawable/bg_cover_preview"
                        android:clipToOutline="true"
                        android:contentDescription="@string/create_photo_preview_a11y"
                        android:scaleType="centerCrop"
                        android:visibility="gone" />
                </FrameLayout>

                <LinearLayout
                    android:id="@+id/photoActions"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:orientation="horizontal"
                    android:visibility="gone"
                    tools:visibility="visible">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/changePhotoButton"
                        style="@style/Widget.LEEF.Button.TextButton"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/create_photo_change" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/removePhotoButton"
                        style="@style/Widget.LEEF.Button.TextButton"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/create_photo_remove" />
                </LinearLayout>

                <TextView
                    android:id="@+id/photoError"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:accessibilityLiveRegion="polite"
                    android:text="@string/create_photo_failed"
                    android:textAppearance="@style/TextAppearance.LEEF.Auth.FieldError"
                    android:visibility="gone"
                    tools:visibility="visible" />

            </LinearLayout>
        </ScrollView>

        <!-- Loading, a problem, or "you can't rate this" -->
        <LinearLayout
            android:id="@+id/statePanel"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingStart="32dp"
            android:paddingEnd="32dp"
            android:visibility="gone">

            <ProgressBar
                android:id="@+id/loadingSpinner"
                style="?android:attr/progressBarStyle"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:indeterminateTint="@color/leef_green_700" />

            <ImageView
                android:id="@+id/stateIcon"
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_state_cloud_off"
                android:visibility="gone"
                app:tint="@color/leef_gray_500" />

            <TextView
                android:id="@+id/stateTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:gravity="center"
                android:textAppearance="@style/TextAppearance.LEEF.Home.StateTitle"
                android:visibility="gone"
                tools:text="Feedback opens when the event is over" />

            <TextView
                android:id="@+id/stateBody"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center"
                android:textAppearance="@style/TextAppearance.LEEF.Home.StateBody"
                android:visibility="gone"
                tools:text="Come back after it ends." />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/stateButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:minWidth="170dp"
                android:text="@string/home_retry"
                android:visibility="gone" />
        </LinearLayout>

        <!-- Feedback sent -->
        <LinearLayout
            android:id="@+id/donePanel"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingStart="32dp"
            android:paddingEnd="32dp"
            android:visibility="gone">

            <ImageView
                android:layout_width="88dp"
                android:layout_height="88dp"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_check_circle" />

            <TextView
                android:id="@+id/doneTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:gravity="center"
                android:text="@string/feedback_done_title"
                android:textAppearance="@style/TextAppearance.LEEF.Home.StateTitle" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center"
                android:text="@string/feedback_done_body"
                android:textAppearance="@style/TextAppearance.LEEF.Home.StateBody" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/shareButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:minWidth="170dp"
                android:text="@string/feedback_share_button"
                app:icon="@drawable/ic_share"
                app:iconGravity="textStart" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/doneButton"
                style="@style/Widget.LEEF.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:minWidth="170dp"
                android:text="@string/feedback_done_button" />
        </LinearLayout>
    </FrameLayout>

    <!-- Pinned Submit button -->
    <LinearLayout
        android:id="@+id/bottomBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/leef_background"
        android:orientation="vertical"
        android:visibility="gone"
        tools:visibility="visible">

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@drawable/bg_bottom_nav_divider" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/submitButton"
            style="@style/Widget.LEEF.Button.Hero"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="20dp"
            android:layout_marginTop="12dp"
            android:layout_marginEnd="20dp"
            android:layout_marginBottom="14dp"
            android:text="@string/feedback_submit"
            app:iconGravity="textStart" />
    </LinearLayout>
</LinearLayout>
