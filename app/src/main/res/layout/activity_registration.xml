<?xml version="1.0" encoding="utf-8"?>
<!-- Screen 7 - Registration & Payment. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/registrationRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/leef_background"
    android:orientation="vertical">

    <!-- Top bar: back and title -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="8dp"
        android:paddingTop="4dp"
        android:paddingEnd="20dp"
        android:paddingBottom="4dp">

        <ImageButton
            android:id="@+id/backButton"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/search_back_a11y"
            android:padding="12dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_arrow_back"
            app:tint="@color/leef_ink" />

        <TextView
            android:id="@+id/screenTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:layout_weight="1"
            android:text="@string/registration_title"
            android:textAppearance="@style/TextAppearance.LEEF.Home.Name" />
    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <!-- Choosing a ticket and a way to pay -->
        <ScrollView
            android:id="@+id/formScroll"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:overScrollMode="never"
            android:visibility="gone"
            tools:visibility="visible">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="20dp"
                android:paddingTop="8dp"
                android:paddingEnd="20dp"
                android:paddingBottom="24dp">

                <!-- The event being registered for -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_info_card"
                    android:orientation="vertical"
                    android:padding="18dp">

                    <TextView
                        android:id="@+id/eventTitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textAppearance="@style/TextAppearance.LEEF.Details.Organizer"
                        tools:text="Future-Ready: AI for Students" />

                    <TextView
                        android:id="@+id/eventWhen"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:textAppearance="@style/TextAppearance.LEEF.Details.Label"
                        tools:text="Sat, Oct 18, 2026 · 9:00 AM – 4:00 PM" />

                    <TextView
                        android:id="@+id/eventWhere"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:textAppearance="@style/TextAppearance.LEEF.Details.Label"
                        tools:text="Ateneo Innovation Center" />
                </LinearLayout>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="24dp"
                    android:text="@string/registration_ticket_type"
                    android:textAppearance="@style/TextAppearance.LEEF.Registration.Section" />

                <LinearLayout
                    android:id="@+id/ticketList"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />

                <!-- Group size (only for the Group ticket) -->
                <LinearLayout
                    android:id="@+id/groupRow"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:background="@drawable/bg_info_card"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="14dp"
                    android:visibility="gone"
                    tools:visibility="visible">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/registration_group_size"
                            android:textAppearance="@style/TextAppearance.LEEF.Registration.RowTitle" />

                        <TextView
                            android:id="@+id/groupHint"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:textAppearance="@style/TextAppearance.LEEF.Registration.RowSubtitle"
                            tools:text="5 to 50 people" />
                    </LinearLayout>

                    <ImageButton
                        android:id="@+id/groupMinus"
                        android:layout_width="44dp"
                        android:layout_height="44dp"
                        android:background="@drawable/bg_stepper_button"
                        android:contentDescription="@string/registration_group_less_a11y"
                        android:padding="11dp"
                        android:src="@drawable/ic_minus"
                        app:tint="@color/leef_green_900" />

                    <TextView
                        android:id="@+id/groupCount"
                        android:layout_width="48dp"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:textAppearance="@style/TextAppearance.LEEF.Registration.RowTitle"
                        tools:text="5" />

                    <ImageButton
                        android:id="@+id/groupPlus"
                        android:layout_width="44dp"
                        android:layout_height="44dp"
                        android:background="@drawable/bg_stepper_button"
                        android:contentDescription="@string/registration_group_more_a11y"
                        android:padding="11dp"
                        android:src="@drawable/ic_plus"
                        app:tint="@color/leef_green_900" />
                </LinearLayout>

                <!-- Payment (hidden when the event is free) -->
                <LinearLayout
                    android:id="@+id/paymentSection"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="24dp"
                        android:text="@string/registration_payment_method"
                        android:textAppearance="@style/TextAppearance.LEEF.Registration.Section" />

                    <LinearLayout
                        android:id="@+id/methodList"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical" />
                </LinearLayout>

                <TextView
                    android:id="@+id/freeNote"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:text="@string/registration_free_note"
                    android:textAppearance="@style/TextAppearance.LEEF.Details.Label"
                    android:visibility="gone" />
            </LinearLayout>
        </ScrollView>

        <!-- Registered -->
        <ScrollView
            android:id="@+id/doneScroll"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:overScrollMode="never"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:paddingStart="20dp"
                android:paddingTop="24dp"
                android:paddingEnd="20dp"
                android:paddingBottom="24dp">

                <ImageView
                    android:layout_width="96dp"
                    android:layout_height="96dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_check_circle" />

                <TextView
                    android:id="@+id/doneTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="18dp"
                    android:gravity="center"
                    android:text="@string/registration_done_title"
                    android:textAppearance="@style/TextAppearance.LEEF.Details.Title" />

                <TextView
                    android:id="@+id/doneEvent"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:gravity="center"
                    android:textAppearance="@style/TextAppearance.LEEF.Details.Summary"
                    tools:text="Future-Ready: AI for Students" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="24dp"
                    android:background="@drawable/bg_info_card"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/registration_done_code_label"
                        android:textAppearance="@style/TextAppearance.LEEF.Details.Label" />

                    <TextView
                        android:id="@+id/doneCode"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:letterSpacing="0.06"
                        android:textAppearance="@style/TextAppearance.LEEF.Details.PriceSecond"
                        android:textIsSelectable="true"
                        tools:text="LEEF-7KQ2MD" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginTop="16dp"
                        android:layout_marginBottom="16dp"
                        android:background="@drawable/bg_price_divider" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/registration_done_ticket_label"
                        android:textAppearance="@style/TextAppearance.LEEF.Details.Label" />

                    <TextView
                        android:id="@+id/doneTicket"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:textAppearance="@style/TextAppearance.LEEF.Details.Line"
                        tools:text="Early Bird" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:text="@string/registration_done_paid_label"
                        android:textAppearance="@style/TextAppearance.LEEF.Details.Label" />

                    <TextView
                        android:id="@+id/donePaid"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:textAppearance="@style/TextAppearance.LEEF.Details.Line"
                        tools:text="₱350 via GCash" />
                </LinearLayout>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:gravity="center"
                    android:text="@string/registration_done_note"
                    android:textAppearance="@style/TextAppearance.LEEF.Details.Label" />
            </LinearLayout>
        </ScrollView>

        <ProgressBar
            android:id="@+id/loading"
            style="?android:attr/progressBarStyle"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_gravity="center"
            android:contentDescription="@string/registration_loading_a11y"
            android:indeterminateTint="@color/leef_green_700" />

        <!-- Couldn't load -->
        <LinearLayout
            android:id="@+id/errorGroup"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingStart="36dp"
            android:paddingEnd="36dp"
            android:visibility="gone">

            <ImageView
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_state_cloud_off"
                app:tint="@color/leef_gray_500" />

            <TextView
                android:id="@+id/errorText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:gravity="center"
                android:textAppearance="@style/TextAppearance.LEEF.Home.StateBody"
                tools:text="We couldn't load events right now. Please try again." />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/retryButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:minWidth="170dp"
                android:text="@string/home_retry" />
        </LinearLayout>

        <!-- Event gone or already over -->
        <LinearLayout
            android:id="@+id/unavailableGroup"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingStart="36dp"
            android:paddingEnd="36dp"
            android:visibility="gone">

            <TextView
                android:id="@+id/unavailableTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:textAppearance="@style/TextAppearance.LEEF.Home.StateTitle"
                tools:text="This event isn't available" />

            <TextView
                android:id="@+id/unavailableBody"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center"
                android:textAppearance="@style/TextAppearance.LEEF.Home.StateBody"
                tools:text="It may have been removed by the organizer." />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/unavailableBackButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:minWidth="170dp"
                android:text="@string/details_go_back" />
        </LinearLayout>
    </FrameLayout>

    <!-- Total and the main button, always in reach -->
    <LinearLayout
        android:id="@+id/bottomBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingTop="10dp"
        android:paddingEnd="20dp"
        android:paddingBottom="12dp"
        android:visibility="gone"
        tools:visibility="visible">

        <LinearLayout
            android:id="@+id/totalRow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="10dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/totalLabel"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textAppearance="@style/TextAppearance.LEEF.Details.Line"
                tools:text="Total" />

            <TextView
                android:id="@+id/totalAmount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textAppearance="@style/TextAppearance.LEEF.Details.PriceSecond"
                tools:text="₱350" />
        </LinearLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/primaryButton"
            style="@style/Widget.LEEF.Button"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/registration_pay_and_register" />
    </LinearLayout>
</LinearLayout>
