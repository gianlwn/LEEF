<?xml version="1.0" encoding="utf-8"?>
<!-- Covers the whole screen while the phone has no internet connection. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/noInternetRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/leef_background"
    android:clickable="true"
    android:focusable="true"
    android:translationZ="200dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingStart="40dp"
        android:paddingEnd="40dp">

        <ImageView
            android:layout_width="72dp"
            android:layout_height="72dp"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_state_cloud_off"
            app:tint="@color/leef_green_700" />

        <TextView
            android:id="@+id/noInternetTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:gravity="center"
            android:text="@string/offline_title"
            android:textAppearance="@style/TextAppearance.LEEF.Home.StateTitle" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:gravity="center"
            android:text="@string/offline_body"
            android:textAppearance="@style/TextAppearance.LEEF.Home.StateBody" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/noInternetRetry"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:minWidth="180dp"
            android:text="@string/offline_retry" />
    </LinearLayout>
</FrameLayout>
