<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/leef_background"
    tools:context=".auth.LogInActivity">

    <ScrollView
        android:id="@+id/scroll"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:overScrollMode="never"
        android:scrollbars="none">

        <FrameLayout
            android:id="@+id/scrollContent"
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <!-- Tree and sun in the top-left corner; decoration only. -->
            <com.itismob.s03.group7.leef.ui.widget.ArtSlotView
                android:id="@+id/cornerArt"
                android:layout_width="190dp"
                android:layout_height="227dp"
                android:layout_gravity="top|start"
                app:leefArtName="art_login_corner"
                app:leefArtTitle="@string/art_title_login_corner" />

            <!-- Books and plants along the bottom edge; decoration only. -->
            <com.itismob.s03.group7.leef.ui.widget.ArtSlotView
                android:id="@+id/scene"
                android:layout_width="match_parent"
                android:layout_height="200dp"
                android:layout_gravity="bottom"
                app:leefArtName="art_login_scene"
                app:leefArtScale="centerCrop"
                app:leefArtTitle="@string/art_title_login_scene" />

            <LinearLayout
                android:id="@+id/content"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="24dp"
                android:paddingEnd="24dp"
                android:paddingTop="128dp"
                android:paddingBottom="200dp">

                <TextView
                    android:id="@+id/title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:text="@string/login_title"
                    android:textAppearance="@style/TextAppearance.LEEF.Auth.Title" />

                <TextView
                    android:id="@+id/subtitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:gravity="center"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:text="@string/login_subtitle"
                    android:textAppearance="@style/TextAppearance.LEEF.Auth.Subtitle" />

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/emailLayout"
                    style="@style/Widget.LEEF.TextInputLayout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="28dp"
                    android:hint="@string/auth_hint_email"
                    app:startIconDrawable="@drawable/ic_field_mail">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/emailInput"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:autofillHints="emailAddress"
                        android:imeOptions="actionNext"
                        android:inputType="textEmailAddress"
                        android:maxLines="1"
                        android:textAppearance="?attr/textAppearanceBodyLarge" />
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/passwordLayout"
                    style="@style/Widget.LEEF.TextInputLayout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:hint="@string/auth_hint_password"
                    app:endIconMode="password_toggle"
                    app:startIconDrawable="@drawable/ic_field_lock">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/passwordInput"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:autofillHints="password"
                        android:imeOptions="actionDone"
                        android:inputType="textPassword"
                        android:maxLines="1"
                        android:textAppearance="?attr/textAppearanceBodyLarge" />
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/forgotButton"
                    style="@style/Widget.LEEF.Button.TextButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="end"
                    android:layout_marginTop="4dp"
                    android:text="@string/login_forgot_password" />

                <TextView
                    android:id="@+id/statusText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:accessibilityLiveRegion="polite"
                    android:gravity="center"
                    android:textAppearance="@style/TextAppearance.LEEF.Auth.FieldError"
                    android:visibility="gone"
                    tools:text="Incorrect email or password. Please try again."
                    tools:visibility="visible" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/logInButton"
                    style="@style/Widget.LEEF.Button.Hero"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="@string/auth_log_in"
                    app:iconGravity="textStart" />

                <LinearLayout
                    android:id="@+id/signUpRow"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginTop="20dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:clickable="true"
                    android:contentDescription="@string/login_sign_up_a11y"
                    android:focusable="true"
                    android:gravity="center"
                    android:minHeight="48dp"
                    android:orientation="horizontal"
                    android:paddingStart="8dp"
                    android:paddingEnd="8dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/login_no_account"
                        android:textAppearance="@style/TextAppearance.LEEF.Auth.Prompt" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="4dp"
                        android:text="@string/login_sign_up"
                        android:textAppearance="@style/TextAppearance.LEEF.Auth.PromptAction" />
                </LinearLayout>
            </LinearLayout>
        </FrameLayout>
    </ScrollView>
</FrameLayout>
