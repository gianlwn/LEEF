<?xml version="1.0" encoding="utf-8"?>
<!-- One piece of feedback in the organizer's list. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="12dp"
    android:background="@drawable/bg_info_card"
    android:orientation="vertical"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <com.itismob.s03.group7.leef.ui.widget.StarRatingBar
            android:id="@+id/stars"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />

        <TextView
            android:id="@+id/date"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:gravity="end"
            android:textAppearance="@style/TextAppearance.LEEF.Details.Label"
            tools:text="Oct 31, 2026" />
    </LinearLayout>

    <TextView
        android:id="@+id/tags"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:textAppearance="@style/TextAppearance.LEEF.Registration.RowSubtitle"
        android:textColor="@color/leef_green_800"
        android:visibility="gone"
        tools:text="Very helpful · Well organized"
        tools:visibility="visible" />

    <TextView
        android:id="@+id/comment"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:textAppearance="@style/TextAppearance.LEEF.Details.Summary"
        android:visibility="gone"
        tools:text="Great talk, loved the hands-on demo."
        tools:visibility="visible" />

    <ImageView
        android:id="@+id/photo"
        android:layout_width="match_parent"
        android:layout_height="160dp"
        android:layout_marginTop="10dp"
        android:background="@drawable/bg_cover_preview"
        android:clipToOutline="true"
        android:contentDescription="@string/feedback_list_photo_a11y"
        android:scaleType="centerCrop"
        android:visibility="gone" />
</LinearLayout>
