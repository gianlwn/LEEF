<?xml version="1.0" encoding="utf-8"?>
<!-- Profile tab: who you are, your account actions, the legal pages and Sign out. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/leef_background"
    android:orientation="vertical">

    <TextView
        android:id="@+id/title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="20dp"
        android:paddingTop="16dp"
        android:paddingEnd="20dp"
        android:text="@string/profile_tab_title"
        android:textAppearance="@style/TextAppearance.LEEF.Details.Title" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:overScrollMode="never"
        android:paddingBottom="24dp"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingTop="16dp"
            android:paddingEnd="20dp">

            <!-- Who you are -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_profile_card"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:padding="24dp">

                <FrameLayout
                    android:layout_width="92dp"
                    android:layout_height="92dp"
                    android:background="@drawable/bg_avatar_ring">

                    <ImageView
                        android:id="@+id/avatarIcon"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:layout_gravity="center"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_nav_profile"
                        app:tint="@color/leef_green_700" />

                    <TextView
                        android:id="@+id/avatarInitials"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:importantForAccessibility="no"
                        android:textAppearance="@style/TextAppearance.LEEF.HeadlineSmall"
                        android:textColor="@color/leef_green_900"
                        android:visibility="gone"
                        tools:text="AS"
                        tools:visibility="visible" />
                </FrameLayout>

                <TextView
                    android:id="@+id/name"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:gravity="center"
                    android:textAppearance="@style/TextAppearance.LEEF.Home.Name"
                    tools:text="Alex Santos" />

                <TextView
                    android:id="@+id/rolePill"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:background="@drawable/bg_role_pill"
                    android:paddingStart="14dp"
                    android:paddingTop="5dp"
                    android:paddingEnd="14dp"
                    android:paddingBottom="5dp"
                    android:textAppearance="@style/TextAppearance.LEEF.LabelLarge"
                    android:textColor="@color/leef_green_900"
                    android:visibility="gone"
                    tools:text="Student"
                    tools:visibility="visible" />

                <LinearLayout
                    android:id="@+id/schoolLine"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:visibility="gone"
                    tools:visibility="visible">

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_field_school"
                        app:tint="@color/leef_gray_700" />

                    <TextView
                        android:id="@+id/school"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:textAppearance="@style/TextAppearance.LEEF.BodyLarge"
                        android:textColor="@color/leef_ink"
                        tools:text="De La Salle University" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/emailLine"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:visibility="gone"
                    tools:visibility="visible">

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_field_mail"
                        app:tint="@color/leef_gray_700" />

                    <TextView
                        android:id="@+id/email"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:textAppearance="@style/TextAppearance.LEEF.BodyLarge"
                        android:textColor="@color/leef_gray_700"
                        tools:text="alex@gmail.com" />
                </LinearLayout>
            </LinearLayout>

            <!-- Account -->
            <TextView
                android:id="@+id/accountHeading"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:layout_marginTop="24dp"
                android:text="@string/profile_section_account"
                android:textAppearance="@style/TextAppearance.LEEF.Profile.Section" />

            <LinearLayout
                android:id="@+id/accountCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_profile_card"
                android:clipToOutline="true"
                android:orientation="vertical">

                <include
                    android:id="@+id/rowEdit"
                    layout="@layout/view_profile_row"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />

                <View
                    android:id="@+id/accountDivider"
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginStart="70dp"
                    android:background="@color/leef_outline" />

                <include
                    android:id="@+id/rowPassword"
                    layout="@layout/view_profile_row"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />
            </LinearLayout>

            <!-- About -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:layout_marginTop="24dp"
                android:text="@string/profile_section_about"
                android:textAppearance="@style/TextAppearance.LEEF.Profile.Section" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_profile_card"
                android:clipToOutline="true"
                android:orientation="vertical">

                <include
                    android:id="@+id/rowTerms"
                    layout="@layout/view_profile_row"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginStart="70dp"
                    android:background="@color/leef_outline" />

                <include
                    android:id="@+id/rowPrivacy"
                    layout="@layout/view_profile_row"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />
            </LinearLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/signOutButton"
                style="@style/Widget.LEEF.Button.SignOut"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="28dp"
                android:text="@string/profile_sign_out"
                app:icon="@drawable/ic_sign_out"
                app:iconGravity="textStart"
                app:iconSize="20dp" />

            <TextView
                android:id="@+id/footer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:gravity="center"
                android:textAppearance="@style/TextAppearance.LEEF.Profile.Footer"
                tools:text="LEEF 1.0 · ITISMOB S03 Group 7" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>
