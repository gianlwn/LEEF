<?xml version="1.0" encoding="utf-8"?>
<!-- Screen 4 - Home / Event Feed. -->
<androidx.swiperefreshlayout.widget.SwipeRefreshLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/swipeRefresh"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:paddingBottom="8dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Greeting, avatar and notifications -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="20dp"
                android:paddingTop="12dp"
                android:paddingEnd="12dp">

                <FrameLayout
                    android:id="@+id/avatar"
                    android:layout_width="58dp"
                    android:layout_height="58dp"
                    android:background="@drawable/bg_avatar_ring"
                    android:clickable="true"
                    android:contentDescription="@string/home_avatar_a11y"
                    android:focusable="true">

                    <ImageView
                        android:id="@+id/avatarIcon"
                        android:layout_width="28dp"
                        android:layout_height="28dp"
                        android:layout_gravity="center"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_nav_profile"
                        app:tint="@color/leef_green_700" />

                    <TextView
                        android:id="@+id/avatarInitials"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:importantForAccessibility="no"
                        android:textAppearance="@style/TextAppearance.LEEF.TitleMedium"
                        android:textColor="@color/leef_green_900"
                        android:textStyle="bold"
                        android:visibility="gone"
                        tools:text="AS"
                        tools:visibility="visible" />
                </FrameLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="14dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/greetingLine"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textAppearance="@style/TextAppearance.LEEF.Home.Greeting"
                        tools:text="Good morning," />

                    <TextView
                        android:id="@+id/nameLine"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:minHeight="34dp"
                        android:textAppearance="@style/TextAppearance.LEEF.Home.Name"
                        android:visibility="invisible"
                        tools:text="Alex!"
                        tools:visibility="visible" />
                </LinearLayout>

                <ImageButton
                    android:id="@+id/notificationsButton"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/home_notifications_a11y"
                    android:padding="11dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_bell"
                    app:tint="@color/leef_ink" />
            </LinearLayout>

            <!-- Search entry: opens the Search & Filter screen -->
            <LinearLayout
                android:id="@+id/searchBar"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginStart="20dp"
                android:layout_marginTop="20dp"
                android:layout_marginEnd="20dp"
                android:background="@drawable/bg_search_bar"
                android:clickable="true"
                android:contentDescription="@string/home_search_hint"
                android:focusable="true"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="20dp"
                android:paddingEnd="20dp">

                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_search"
                    app:tint="@color/leef_gray_700" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:importantForAccessibility="no"
                    android:maxLines="1"
                    android:text="@string/home_search_hint"
                    android:textAppearance="@style/TextAppearance.LEEF.Home.Hint" />
            </LinearLayout>

            <!-- Category chips -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/categoryList"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:clipToPadding="false"
                android:overScrollMode="never"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                tools:itemCount="5"
                tools:listitem="@layout/item_category_chip" />

            <com.google.android.material.progressindicator.CircularProgressIndicator
                android:id="@+id/loading"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="56dp"
                android:contentDescription="@string/home_loading_a11y"
                android:indeterminate="true"
                app:indicatorColor="@color/leef_green_700" />

            <!-- First load failed -->
            <LinearLayout
                android:id="@+id/errorGroup"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="40dp"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:paddingStart="36dp"
                android:paddingEnd="36dp"
                android:visibility="gone">

                <ImageView
                    android:layout_width="56dp"
                    android:layout_height="56dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_state_cloud_off"
                    app:tint="@color/leef_gray_500" />

                <TextView
                    android:id="@+id/errorText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:gravity="center"
                    android:textAppearance="@style/TextAppearance.LEEF.Home.StateBody"
                    tools:text="We couldn't load events right now. Please try again." />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/retryButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:minWidth="170dp"
                    android:text="@string/home_retry" />
            </LinearLayout>

            <!-- No events (at all, or in this category) -->
            <LinearLayout
                android:id="@+id/emptyGroup"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:paddingStart="36dp"
                android:paddingEnd="36dp"
                android:visibility="gone">

                <com.itismob.s03.group7.leef.ui.widget.ArtSlotView
                    android:layout_width="240dp"
                    android:layout_height="190dp"
                    app:leefArtName="art_home_empty"
                    app:leefArtTitle="@string/art_title_home_empty" />

                <TextView
                    android:id="@+id/emptyTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:gravity="center"
                    android:textAppearance="@style/TextAppearance.LEEF.Home.StateTitle"
                    tools:text="No events yet" />

                <TextView
                    android:id="@+id/emptyBody"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:gravity="center"
                    android:textAppearance="@style/TextAppearance.LEEF.Home.StateBody"
                    tools:text="New seminars, workshops and competitions will show up here." />
            </LinearLayout>

            <!-- Featured (boosted) events -->
            <LinearLayout
                android:id="@+id/featuredSection"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone"
                tools:visibility="visible">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="20dp"
                    android:paddingEnd="12dp">

                    <TextView
                        android:id="@+id/featuredTitle"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/home_featured_title"
                        android:textAppearance="@style/TextAppearance.LEEF.Home.SectionTitle" />

                    <TextView
                        android:id="@+id/featuredSeeAll"
                        android:layout_width="wrap_content"
                        android:layout_height="48dp"
                        android:background="?attr/selectableItemBackground"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center"
                        android:paddingStart="8dp"
                        android:paddingEnd="8dp"
                        android:text="@string/home_see_all"
                        android:textAppearance="@style/TextAppearance.LEEF.Home.SeeAll" />
                </LinearLayout>

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/featuredList"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:clipToPadding="false"
                    android:overScrollMode="never"
                    android:paddingStart="20dp"
                    android:paddingTop="6dp"
                    android:paddingEnd="20dp"
                    android:paddingBottom="10dp"
                    tools:itemCount="1"
                    tools:listitem="@layout/item_event_featured" />
            </LinearLayout>

            <!-- Upcoming events -->
            <LinearLayout
                android:id="@+id/upcomingSection"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone"
                tools:visibility="visible">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="20dp"
                    android:paddingEnd="12dp">

                    <TextView
                        android:id="@+id/upcomingTitle"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/home_upcoming_title"
                        android:textAppearance="@style/TextAppearance.LEEF.Home.SectionTitle" />

                    <TextView
                        android:id="@+id/upcomingSeeAll"
                        android:layout_width="wrap_content"
                        android:layout_height="48dp"
                        android:background="?attr/selectableItemBackground"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center"
                        android:paddingStart="8dp"
                        android:paddingEnd="8dp"
                        android:text="@string/home_see_all"
                        android:textAppearance="@style/TextAppearance.LEEF.Home.SeeAll" />
                </LinearLayout>

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/upcomingList"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:clipToPadding="false"
                    android:overScrollMode="never"
                    android:paddingStart="20dp"
                    android:paddingTop="6dp"
                    android:paddingEnd="20dp"
                    android:paddingBottom="20dp"
                    tools:itemCount="2"
                    tools:listitem="@layout/item_event_row" />
            </LinearLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</androidx.swiperefreshlayout.widget.SwipeRefreshLayout>
