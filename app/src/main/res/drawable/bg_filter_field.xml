<?xml version="1.0" encoding="utf-8"?>
<!-- Outlined white field used for the date and location boxes in the Filters sheet. -->
<ripple xmlns:android="http://schemas.android.com/apk/res/android" android:color="@color/leef_green_100">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/white" />
            <stroke android:width="1dp" android:color="@color/leef_outline" />
            <corners android:radius="16dp" />
        </shape>
    </item>
</ripple>
