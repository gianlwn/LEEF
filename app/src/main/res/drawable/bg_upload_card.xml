<?xml version="1.0" encoding="utf-8"?>
<!-- Dashed "add a photo" card on Create Event. -->
<ripple xmlns:android="http://schemas.android.com/apk/res/android" android:color="@color/leef_green_100">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/leef_field" />
            <stroke
                android:width="1.5dp"
                android:color="@color/leef_gray_300"
                android:dashGap="6dp"
                android:dashWidth="8dp" />
            <corners android:radius="20dp" />
        </shape>
    </item>
</ripple>
