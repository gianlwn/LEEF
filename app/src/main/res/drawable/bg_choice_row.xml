<?xml version="1.0" encoding="utf-8"?>
<!-- An option row (ticket type, payment method): white with a sand outline, green when chosen. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/leef_cream_light" />
            <corners android:radius="18dp" />
            <stroke android:width="2dp" android:color="@color/leef_green_700" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/white" />
            <corners android:radius="18dp" />
            <stroke android:width="1dp" android:color="@color/leef_outline" />
        </shape>
    </item>
</selector>
