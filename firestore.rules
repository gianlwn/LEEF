rules_version = '2';

// LEEF Firestore security rules.
// Firebase console -> Firestore Database -> Rules -> paste this file -> Publish.
// (Kept in the repo so the whole team can see what is published; update it as each screen needs more.)
service cloud.firestore {
  match /databases/{database}/documents {

    // Screen 2: every signed-in person owns exactly one profile at users/{their uid}.
    match /users/{userId} {
      allow read: if request.auth != null && request.auth.uid == userId;

      allow create: if request.auth != null
        && request.auth.uid == userId
        && request.resource.data.fullName is string
        && request.resource.data.fullName.size() > 0
        && request.resource.data.fullName.size() <= 80
        && request.resource.data.schoolOrganization is string
        && request.resource.data.schoolOrganization.size() > 0
        && request.resource.data.schoolOrganization.size() <= 100
        && request.resource.data.email is string
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.role in ['student', 'teacher', 'organizer', 'parent', 'freelancer'];

      // Profile tab: a person can change only their name, school or organization and role (the email and
      // creation time stay as they are), with the same limits as when the account was created.
      allow update: if request.auth != null
        && request.auth.uid == userId
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['fullName', 'schoolOrganization', 'role'])
        && request.resource.data.fullName is string
        && request.resource.data.fullName.size() > 0
        && request.resource.data.fullName.size() <= 80
        && request.resource.data.schoolOrganization is string
        && request.resource.data.schoolOrganization.size() > 0
        && request.resource.data.schoolOrganization.size() <= 100
        && request.resource.data.role in ['student', 'teacher', 'organizer', 'parent', 'freelancer'];
      allow delete: if false;
    }

    // Screen 4: events anyone signed in can browse. Screen 11: accounts with the Organizer role can post
    // new events. The organizer who posted an event can then change it in three ways, each with its own
    // rule below: boost it (isBoostOfOwnEvent), edit its details before it starts (isEditOfOwnEvent), or
    // cancel it before it starts (isCancelOfOwnEvent). Nobody can delete an event: a cancelled event stays
    // on record, marked `cancelled`. Events added by hand in the Firebase console are not affected by
    // these rules.
    function isOrganizer() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'organizer';
    }

    // The details an organizer fills in on Create/Edit Event, checked the same way both times. The
    // start time is checked by the callers (new events and edits both need a start in the future).
    function hasValidEventDetails(d) {
      return d.title is string && d.title.size() > 0 && d.title.size() <= 100
        && d.category in ['seminar', 'workshop', 'competition', 'school_activity']
        && d.startsAt is timestamp
        && (!('endsAt' in d) || (d.endsAt is timestamp && d.endsAt > d.startsAt))
        && d.get('description', '') is string && d.get('description', '').size() <= 500
        && d.get('venue', '') is string && d.get('venue', '').size() <= 120
        && d.get('city', '') is string && d.get('city', '').size() <= 60
        && d.audiences is list && d.audiences.size() <= 5
        && d.audiences.hasOnly(['students', 'teachers', 'parents', 'freelancers', 'school_admins'])
        && d.tags is list && d.tags.size() <= 5
        && d.price is number && d.price >= 0 && d.price <= 100000
        && (('earlyBirdPrice' in d) == ('earlyBirdUntil' in d))
        && (!('earlyBirdPrice' in d)
          || (d.earlyBirdPrice is number && d.earlyBirdPrice >= 0 && d.earlyBirdPrice < d.price
            && d.earlyBirdUntil is timestamp && d.earlyBirdUntil <= d.startsAt))
        && (!('groupPrice' in d) || (d.groupPrice is number && d.groupPrice >= 0 && d.groupPrice < d.price))
        && (!('coverUrl' in d) || (d.coverUrl is string && d.coverUrl.matches('https://.+') && d.coverUrl.size() <= 500));
    }

    function isNewEvent() {
      let d = request.resource.data;
      return d.keys().hasAll(['title', 'category', 'startsAt', 'price', 'organizerId', 'organizerName', 'createdAt', 'boosted'])
        && d.keys().hasOnly(['title', 'category', 'startsAt', 'endsAt', 'description', 'venue', 'city',
          'audiences', 'tags', 'price', 'earlyBirdPrice', 'earlyBirdUntil', 'groupPrice', 'coverUrl',
          'organizerId', 'organizerName', 'createdAt', 'boosted'])
        && hasValidEventDetails(d)
        && d.startsAt > request.time
        && d.organizerId == request.auth.uid
        && d.organizerName is string && d.organizerName.size() > 0 && d.organizerName.size() <= 100
        && d.createdAt == request.time
        && d.boosted == false;
    }

    // Edit Event: the organizer who posted an event may change its details until it starts, and only
    // while it isn't cancelled. Only the fields on the Create Event form can change (not the organizer,
    // the creation time, the boost or the cancellation), the result must pass the same checks as a new
    // event, and the start must stay in the future.
    //
    // The app also keeps the prices as they were once people have registered. The rules can't enforce
    // that (a rule can't count registrations), so it is a promise made by the app, not by the database.
    function isEditOfOwnEvent() {
      let d = request.resource.data;
      return d.diff(resource.data).affectedKeys().hasOnly(['title', 'category', 'startsAt', 'endsAt',
          'description', 'venue', 'city', 'audiences', 'tags', 'price', 'earlyBirdPrice', 'earlyBirdUntil',
          'groupPrice', 'coverUrl'])
        && resource.data.get('organizerId', '') == request.auth.uid
        && resource.data.get('cancelled', false) == false
        && resource.data.startsAt > request.time
        && hasValidEventDetails(d)
        && d.startsAt > request.time;
    }

    // Cancel Event: the organizer may cancel their own event before it starts, once. That sets only
    // `cancelled` (to true) and `cancelledAt` (to now); it can't be undone from the app.
    function isCancelOfOwnEvent() {
      let d = request.resource.data;
      return d.diff(resource.data).affectedKeys().hasOnly(['cancelled', 'cancelledAt'])
        && resource.data.get('organizerId', '') == request.auth.uid
        && resource.data.get('cancelled', false) == false
        && resource.data.startsAt > request.time
        && d.cancelled == true
        && d.cancelledAt == request.time;
    }

    // Promote Event: the organizer who posted an event may boost it before it starts. That changes only
    // `boosted` and `boostedUntil`, and the end must be in the future but no more than 31 days ahead.
    // A cancelled event can't be boosted.
    function isBoostOfOwnEvent() {
      let d = request.resource.data;
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(['boosted', 'boostedUntil'])
        && resource.data.get('organizerId', '') == request.auth.uid
        && resource.data.get('cancelled', false) == false
        && resource.data.startsAt > request.time
        && d.boosted == true
        && d.boostedUntil is timestamp
        && d.boostedUntil > request.time
        && d.boostedUntil <= request.time + duration.value(31, 'd');
    }

    match /events/{eventId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && isOrganizer() && isNewEvent();
      allow update: if request.auth != null
        && (isBoostOfOwnEvent() || isEditOfOwnEvent() || isCancelOfOwnEvent());
      allow delete: if false;
    }

    // Promote Event: one receipt per paid boost at boosts/{id}. The payment is simulated, so the rules
    // don't check it; they check the plan and its price (the ones in model/BoostPlan.java), that the
    // person is the event's organizer, and that nobody can change or delete a receipt. Only the person
    // who paid can read their receipts.
    function isBoostPlanPrice(d) {
      return (d.plan == 'day' && d.days == 1 && d.amount == 599)
        || (d.plan == 'three_days' && d.days == 3 && d.amount == 899)
        || (d.plan == 'week' && d.days == 7 && d.amount == 1299);
    }

    match /boosts/{boostId} {
      allow get: if request.auth != null && resource.data.userId == request.auth.uid;
      allow list: if request.auth != null && resource.data.userId == request.auth.uid;
      allow create: if request.auth != null
        && request.resource.data.keys().hasOnly(['userId', 'eventId', 'eventTitle', 'plan', 'days', 'amount',
          'paymentMethod', 'confirmationCode', 'boostedUntil', 'createdAt'])
        && request.resource.data.keys().hasAll(['userId', 'eventId', 'eventTitle', 'plan', 'days', 'amount',
          'paymentMethod', 'confirmationCode', 'boostedUntil', 'createdAt'])
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.eventId is string
        && get(/databases/$(database)/documents/events/$(request.resource.data.eventId)).data.get('organizerId', '') == request.auth.uid
        && isBoostPlanPrice(request.resource.data)
        && request.resource.data.paymentMethod in ['gcash', 'maya', 'card']
        && request.resource.data.confirmationCode is string
        && request.resource.data.eventTitle is string
        && request.resource.data.boostedUntil is timestamp
        && request.resource.data.createdAt == request.time;
      allow update, delete: if false;
    }

    // Screen 4: the hearts. Each person keeps their own saved events at users/{uid}/savedEvents/{eventId}.
    match /users/{userId}/savedEvents/{eventId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow create, update: if request.auth != null
        && request.auth.uid == userId
        && request.resource.data.keys().hasOnly(['savedAt']);
      allow delete: if request.auth != null && request.auth.uid == userId;
    }

    // Screen 7: registrations. One document per person per event, named {uid}_{eventId}, so nobody can
    // register twice. The payment is simulated, so the rules don't check prices; they only make sure a
    // person writes their own registration for an event that exists and hasn't been cancelled.
    //
    // Organizer tools: the organizer of an event may list its registrations (the attendee list) and may
    // check one in: that sets only `checkedInAt` (to now) and `checkedInBy` (themselves), once. Nobody can
    // create a registration that is already checked in, and nothing else about a registration can change.
    function isOrganizerOf(eventId) {
      return get(/databases/$(database)/documents/events/$(eventId)).data.get('organizerId', '') == request.auth.uid;
    }

    match /registrations/{registrationId} {
      allow get: if request.auth != null
        && registrationId.matches(request.auth.uid + '_.*');
      allow list: if request.auth != null
        && (resource.data.userId == request.auth.uid || isOrganizerOf(resource.data.eventId));
      allow create: if request.auth != null
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.eventId is string
        && registrationId == request.auth.uid + '_' + request.resource.data.eventId
        && exists(/databases/$(database)/documents/events/$(request.resource.data.eventId))
        && get(/databases/$(database)/documents/events/$(request.resource.data.eventId)).data.get('cancelled', false) == false
        && request.resource.data.ticketType in ['earlyBird', 'regular', 'group']
        && request.resource.data.quantity is number
        && request.resource.data.quantity >= 1
        && request.resource.data.quantity <= 50
        && request.resource.data.amount is number
        && request.resource.data.amount >= 0
        && request.resource.data.confirmationCode is string
        && request.resource.data.status == 'confirmed'
        && (!('attendeeName' in request.resource.data)
          || (request.resource.data.attendeeName is string && request.resource.data.attendeeName.size() <= 100))
        && !('checkedInAt' in request.resource.data)
        && !('checkedInBy' in request.resource.data);
      allow update: if request.auth != null
        && isOrganizerOf(resource.data.eventId)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['checkedInAt', 'checkedInBy'])
        && !('checkedInAt' in resource.data)
        && request.resource.data.checkedInAt == request.time
        && request.resource.data.checkedInBy == request.auth.uid;
      allow delete: if false;
    }

    // Screen 10: messaging.
    //
    // Event chats live at eventChats/{eventId} (the latest-message summary) with their messages in
    // eventChats/{eventId}/messages. Anyone registered for the event can read and write them; so can the
    // event's organizer once an event has an `organizerId` (Screen 11).
    function isEventMember(eventId) {
      return exists(/databases/$(database)/documents/registrations/$(request.auth.uid + '_' + eventId))
        || get(/databases/$(database)/documents/events/$(eventId)).data.get('organizerId', '') == request.auth.uid;
    }

    function isNewMessage() {
      return request.resource.data.keys().hasOnly(['senderId', 'senderName', 'text', 'sentAt'])
        && request.resource.data.senderId == request.auth.uid
        && request.resource.data.senderName is string
        && request.resource.data.senderName.size() > 0
        && request.resource.data.senderName.size() <= 80
        && request.resource.data.text is string
        && request.resource.data.text.size() > 0
        && request.resource.data.text.size() <= 1000
        && request.resource.data.sentAt == request.time;
    }

    function isLatestMessageSummary() {
      return request.resource.data.lastMessage is string
        && request.resource.data.lastMessage.size() > 0
        && request.resource.data.lastMessage.size() <= 200
        && request.resource.data.lastSenderId == request.auth.uid
        && request.resource.data.lastSenderName is string
        && request.resource.data.lastSenderName.size() <= 80
        && request.resource.data.lastMessageAt == request.time;
    }

    match /eventChats/{eventId} {
      allow get: if request.auth != null && isEventMember(eventId);
      allow create, update: if request.auth != null
        && isEventMember(eventId)
        && request.resource.data.keys().hasOnly(['eventTitle', 'lastMessage', 'lastSenderId', 'lastSenderName', 'lastMessageAt'])
        && request.resource.data.eventTitle is string
        && request.resource.data.eventTitle.size() <= 200
        && isLatestMessageSummary();
      allow delete: if false;

      match /messages/{messageId} {
        allow read: if request.auth != null && isEventMember(eventId);
        allow create: if request.auth != null && isEventMember(eventId) && isNewMessage();
        allow update, delete: if false;
      }
    }

    // Direct chats live at directChats/{uidA_uidB} (the two user ids in alphabetical order), so there is
    // one chat per pair. Only the two people can read or write it.
    match /directChats/{chatId} {
      allow get: if request.auth != null
        && (resource == null || request.auth.uid in resource.data.members);
      allow list: if request.auth != null
        && request.auth.uid in resource.data.members;
      allow create: if request.auth != null
        && request.resource.data.keys().hasOnly(['members', 'names', 'lastMessage', 'lastSenderId', 'lastSenderName', 'lastMessageAt'])
        && request.resource.data.members is list
        && request.resource.data.members.size() == 2
        && request.resource.data.members[0] < request.resource.data.members[1]
        && chatId == request.resource.data.members[0] + '_' + request.resource.data.members[1]
        && request.auth.uid in request.resource.data.members
        && exists(/databases/$(database)/documents/users/$(request.resource.data.members[0]))
        && exists(/databases/$(database)/documents/users/$(request.resource.data.members[1]))
        && request.resource.data.names is map
        && isLatestMessageSummary();
      allow update: if request.auth != null
        && request.auth.uid in resource.data.members
        && request.resource.data.members == resource.data.members
        && request.resource.data.keys().hasOnly(['members', 'names', 'lastMessage', 'lastSenderId', 'lastSenderName', 'lastMessageAt'])
        && isLatestMessageSummary();
      allow delete: if false;

      match /messages/{messageId} {
        allow read: if request.auth != null
          && request.auth.uid in get(/databases/$(database)/documents/directChats/$(chatId)).data.members;
        // getAfter so the first message can be written in the same batch that creates the chat.
        allow create: if request.auth != null
          && request.auth.uid in getAfter(/databases/$(database)/documents/directChats/$(chatId)).data.members
          && isNewMessage();
        allow update, delete: if false;
      }
    }

    // Screen 10: when each person last read each chat (drives the unread badges), at
    // users/{uid}/chatReads/{event_<eventId> | dm_<chatId>}.
    match /users/{userId}/chatReads/{chatKey} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow create, update: if request.auth != null
        && request.auth.uid == userId
        && request.resource.data.keys().hasOnly(['lastReadAt'])
        && request.resource.data.lastReadAt == request.time;
      allow delete: if false;
    }

    // Screen 12: feedback on an event, at events/{eventId}/feedback/{uid} (one per person, editable).
    // Only the author and the event's organizer can read it, and it stores no names. Only someone who
    // registered can write it, and only once the event has started (the app opens the form once it ends).
    function isEventOrganizer(eventId) {
      return get(/databases/$(database)/documents/events/$(eventId)).data.get('organizerId', '') == request.auth.uid;
    }

    function isValidFeedback() {
      let d = request.resource.data;
      return d.keys().hasAll(['userId', 'rating', 'tags', 'submittedAt'])
        && d.keys().hasOnly(['userId', 'rating', 'tags', 'comment', 'photoUrl', 'submittedAt'])
        && d.userId == request.auth.uid
        && d.rating is int && d.rating >= 1 && d.rating <= 5
        && d.tags is list && d.tags.size() <= 6
        && d.tags.hasOnly(['very_helpful', 'well_organized', 'great_speakers', 'learned_a_lot', 'met_new_people', 'would_recommend'])
        && (!('comment' in d) || (d.comment is string && d.comment.size() <= 300))
        && (!('photoUrl' in d) || (d.photoUrl is string && d.photoUrl.matches('https://.+') && d.photoUrl.size() <= 500))
        && d.submittedAt == request.time;
    }

    match /events/{eventId}/feedback/{userId} {
      allow get: if request.auth != null
        && (request.auth.uid == userId || isEventOrganizer(eventId));
      allow list: if request.auth != null && isEventOrganizer(eventId);
      allow create, update: if request.auth != null
        && request.auth.uid == userId
        && exists(/databases/$(database)/documents/registrations/$(request.auth.uid + '_' + eventId))
        && get(/databases/$(database)/documents/events/$(eventId)).data.startsAt < request.time
        && isValidFeedback();
      allow delete: if false;
    }

    // Everything else stays locked until the screen that needs it is built.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
